<mxfile host="app.diagrams.net" type="device"><diagram id="g-classes" name="1 Action generators (classes)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="g-classes-c1" value="Heterogeneous MCTS: action generators, class diagram" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1620" height="30" as="geometry"/></mxCell><mxCell id="g-classes-c2" value="HMCTSGameState.legal_moves() builds a node's edges from the decision its state is at. Purchase edges come from HeterogeneousMCTS.affordable_units; combat and non-combat move edges come from the generator modules, reached through generators.ag. The other search variants use copies of these generator modules." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1620" height="36" as="geometry"/></mxCell><mxCell id="g-classes-c3" value="«module» generators.py" style="rounded=1;arcSize=2;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="380" height="150" as="geometry"/></mxCell><mxCell id="g-classes-c4" value="generators" style="swimlane;fontStyle=1;align=center;startSize=26;html=1;whiteSpace=wrap;childLayout=stackLayout;horizontal=1;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="35" y="120" width="350" height="98" as="geometry"/></mxCell><mxCell id="g-classes-c5" value="+ ag: module  = action_generators_cy (Cython build)" style="text;strokeColor=n
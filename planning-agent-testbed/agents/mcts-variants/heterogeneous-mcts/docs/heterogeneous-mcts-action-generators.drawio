y relative="1" as="geometry"/></mxCell><mxCell id="g-classes-c103" value="«call» non-combat move:&lt;br&gt;ncg.noncombat_actions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;dashed=1;" edge="1" parent="1" source="g-classes-c10" target="g-classes-c76"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-classes-c104" value="«create»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;dashed=1;" edge="1" parent="1" source="g-classes-c76" target="g-classes-c71"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-classes-c105" value="«use»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;dashed=1;" edge="1" parent="1" source="g-classes-c76" target="g-classes-c83"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-classes-c106" value="«use» via ag" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;dashed=1;" edge="1" parent="1" source="g-classes-c83" target="g-classes-c60"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-classes-c107" value="«use»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;dashed=1;" edge="1" parent="1" source="g-classes-c52" target="g-classes-c60"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-classes-c108" value="ag" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;dashed=1;" edge="1" parent="1" source="g-classes-c4" target="g-classes-c52"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-classes-c109" value="reads" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;dashed=1;" edge="1" parent="1" source="g-classes-c52" target="g-classes-c93"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-classes-c110" value="view()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;dashed=1;exitX=1;exitY=0.05;" edge="1" parent="1" source="g-classes-c10" target="g-classes-c93"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-classes-c111" value='&lt;table border="1" cellpadding="4" style="border-collapse:collapse;font-size:10px;"&gt;&lt;tr style="background:#eeeeee;"&gt;&lt;th&gt;phase&lt;/th&gt;&lt;th&gt;generator (legal_moves)&lt;/th&gt;&lt;th&gt;one tree edge&lt;/th&gt;&lt;th&gt;state carried between edges&lt;/th&gt;&lt;th&gt;nothing left&lt;/th&gt;&lt;th&gt;forced moves&lt;/th&gt;&lt;th&gt;rollout policy&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;purchase&lt;/td&gt;&lt;td&gt;HeterogeneousMCTS.affordable_units(sim, player, next_unit)&lt;/td&gt;&lt;td&gt;PurchaseUnit: one unit of one production rule&lt;/td&gt;&lt;td&gt;next_unit = index of the last unit bought&lt;/td&gt;&lt;td&gt;[PurchaseUnit(end_phase)]&lt;/td&gt;&lt;td&gt;none&lt;/td&gt;&lt;td&gt;_rollout_purchase: ε-greedy over affordable_units, best (attack + defense) / PU&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;combat move&lt;/td&gt;&lt;td&gt;ag.combat_actions(view, d, excluded, player)&lt;/td&gt;&lt;td&gt;CombatAction: one attack set on the top target, or skip it&lt;/td&gt;&lt;td&gt;excluded = targets decided or unreachable&lt;/td&gt;&lt;td&gt;[CombatAction(end_phase)]&lt;/td&gt;&lt;td&gt;none (battles are fought later)&lt;/td&gt;&lt;td&gt;_rollout_combat: combat_actions + ε-greedy / evaluate pick&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;non-combat move&lt;/td&gt;&lt;td&gt;ncg.noncombat_actions(view, d, excluded, moved, player)&lt;/td&gt;&lt;td&gt;NoncombatAction: one reinforcement set for the most needy territory, or skip it&lt;/td&gt;&lt;td&gt;excluded = territories decided; moved = units moved&lt;/td&gt;&lt;td&gt;[NoncombatAction(end_phase, moves = positioning_moves)]&lt;/td&gt;&lt;td&gt;land_air_moves at start_phase; positioning moves at finish_phase&lt;/td&gt;&lt;td&gt;from the start: ag.noncombat_move (greedy); mid-phase: first (strongest) action per territory&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=fill;" vertex="1" parent="1"><mxGeometry x="20" y="1000" width="1660" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="g-purchase" name="2 Purchase action generation"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="g-purchase-c1" value="Purchase: activity diagram of legal_moves() at a purchase node" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1620" height="30" as="geometry"/></mxCell><mxCell id="g-purchase-c2" value="One edge per affordable unit. Units are offered from the index of the last unit bought, so every multiset of units has exactly one path in the tree (no transpositions)." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1620" height="36" as="geometry"/></mxCell><mxCell id="g-purchase-c3" value="HMCTSGameState  (hmcts.py)" style="swimlane;html=1;startSize=28;fillColor=#f8f8f8;strokeColor=#999999;fontStyle=1;fontSize=12;swimlaneFillColor=none;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="540" height="990" as="geometry"/></mxCell><mxCell id="g-purchase-c4" value="HeterogeneousMCTS  (hmcts.py)" style="swimlane;html=1;startSize=28;fillColor=#f8f8f8;strokeColor=#999999;fontStyle=1;fontSize=12;swimlaneFillColor=none;dashed=1;" vertex="1" parent="1"><mxGeometry x="580" y="90" width="560" height="990" as="geometry"/></mxCell><mxCell id="g-purchase-c5" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="275" y="130" width="30" height="30" as="geometry"/></mxCell><mxCell id="g-purchase-c6" value="&lt;b&gt;legal_moves()&lt;/b&gt;  phase == purchase&lt;br&gt;next_unit = index of the last unit bought (0 when the phase starts)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="90" y="185" width="400" height="60" as="geometry"/></mxCell><mxCell id="g-purchase-c7" value="&lt;b&gt;affordable_units(sim, player, first = next_unit)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="640" y="185" width="440" height="60" as="geometry"/></mxCell><mxCell id="g-purchase-c8" value="player owns a factory&lt;br&gt;on a territory it owns?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="750" y="280" width="220" height="100" as="geometry"/></mxCell><mxCell id="g-purchase-c9" value="&lt;b&gt;unit_rules(player)&lt;/b&gt;  (cached per player)&lt;br&gt;for each rule in the player's production frontier keep it if: one result, quantity 1, paid in PUs only, cost &amp;gt; 0, land unit, not infrastructure, not AA&lt;br&gt;→ PurchaseUnit(rule_id, unit_type, costs, strength = (attack + defense) / cost, index)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="640" y="420" width="440" height="130" as="geometry"/></mxCell><mxCell id="g-purchase-c10" value="keep candidates[first:] whose every cost ≤ the player's balance (candidate order kept)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="640" y="585" width="440" height="55" as="geometry"/></mxCell><mxCell id="g-purchase-c11" value="any unit&lt;br&gt;returned?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="190" y="680" width="200" height="90" as="geometry"/></mxCell><mxCell id="g-purchase-c12" value="&lt;b&gt;actions&lt;/b&gt; = the affordable units, in candidate order&lt;br&gt;(one tree edge each)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="250" height="70" as="geometry"/></mxCell><mxCell id="g-purchase-c13" value="&lt;b&gt;actions&lt;/b&gt; = [PurchaseUnit(end_phase=True)]&lt;br&gt;no_target → pass_phase" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="310" y="820" width="230" height="70" as="geometry"/></mxCell><mxCell id="g-purchase-c14" value="&lt;b&gt;expand → apply_move(unit)&lt;/b&gt;&lt;br&gt;fm.PurchaseAction(((rule_id, 1),)) on the sim&lt;br&gt;next_unit = unit.index" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="935" width="250" height="80" as="geometry"/></mxCell><mxCell id="g-purchase-c15" value="" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="410" y="960" width="30" height="30" as="geometry"/></mxCell><mxCell id="g-purchase-c16" value="END is never a tree edge: the phase ends, place and battles are played by the rollout policies, and the node becomes the next searched decision." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="310" y="995" width="240" height="60" as="geometry"/></mxCell><mxCell id="g-purchase-c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="g-purchase-c5" target="g-purchase-c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-purchase-c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="g-purchase-c6" target="g-purchase-c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-purchase-c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="g-purchase-c7" target="g-purchase-c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-purchase-c20" value="[yes]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="g-purchase-c8" target="g-purchase-c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-purchase-c21" value="[no] → []" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="g-purchase-c8" target="g-purchase-c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-purchase-c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="g-purchase-c9" target="g-purchase-c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-purchase-c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="g-purchase-c10" target="g-purchase-c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-purchase-c24" value="[yes]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="g-purchase-c11" target="g-purchase-c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-purchase-c25" value="[no]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="g-purchase-c11" target="g-purchase-c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-purchase-c26" value="child node of the chosen edge" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="g-purchase-c12" target="g-purchase-c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-purchase-c27" value="next legal_moves()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="g-purchase-c14" target="g-purchase-c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-purchase-c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="g-purchase-c13" target="g-purchase-c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-purchase-c29" value="&lt;b&gt;Why candidate order&lt;/b&gt;&lt;br&gt;Buying A then B and B then A would reach the same state. Offering only units at or after the last one bought keeps one path per set of units, so visits are not split over transpositions." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1170" y="120" width="500" height="100" as="geometry"/></mxCell><mxCell id="g-purchase-c30" value="&lt;b&gt;Outside the tree&lt;/b&gt;&lt;br&gt;• Rollouts: _rollout_purchase repeats affordable_units(first = 0) and picks with pick_rollout_move_epsilon_greedy (random with probability ε, else the best strength) until nothing is affordable.&lt;br&gt;• Answer: play_phase plays the chosen edges, then spends what is left greedily by strength.&lt;br&gt;• Place is never searched: _place_units puts every unit bought at the home factory (ag._home_factory)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1170" y="240" width="500" height="170" as="geometry"/></mxCell><mxCell id="g-purchase-c31" value="&lt;b&gt;action_generators.purchase_actions&lt;/b&gt; is the greedy round-robin purchase of the live tripleMind agent. It uses the same candidate filter (land combat units paid in PUs) but the heterogeneous search does not call it." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1170" y="430" width="500" height="90" as="geometry"/></mxCell><mxCell id="g-purchase-c32" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="1170" y="560" width="200" height="20" as="geometry"/></mxCell><mxCell id="g-purchase-c33" value="step" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1170" y="584" width="120" height="26" as="geometry"/></mxCell><mxCell id="g-purchase-c34" value="actions returned (tree edges)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1300" y="584" width="200" height="26" as="geometry"/></mxCell><mxCell id="g-purchase-c35" value="forced moves (not an edge)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1170" y="618" width="200" height="26" as="geometry"/></mxCell><mxCell id="g-purchase-c36" value="guard" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1380" y="614" width="90" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="g-combat" name="3 Combat move action generation"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="g-combat-c1" value="Combat move: activity diagram of legal_moves() at a combat-move node" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1620" height="30" as="geometry"/></mxCell><mxCell id="g-combat-c2" value="ag.combat_actions decides one target per call: the attack sets on the most important enemy territory not yet decided (strongest first), then a skip of it. The next node asks for the next target." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1620" height="36" as="geometry"/></mxCell><mxCell id="g-combat-c3" value="HMCTSGameState  (hmcts.py)" style="swimlane;html=1;startSize=28;fillColor=#f8f8f8;strokeColor=#999999;fontStyle=1;fontSize=12;swimlaneFillColor=none;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="480" height="1040" as="geometry"/></mxCell><mxCell id="g-combat-c4" value="action_generators.combat_actions  (via generators.ag)" style="swimlane;html=1;startSize=28;fillColor=#f8f8f8;strokeColor=#999999;fontStyle=1;fontSize=12;swimlaneFillColor=none;dashed=1;" vertex="1" parent="1"><mxGeometry x="520" y="90" width="720" height="1040" as="geometry"/></mxCell><mxCell id="g-combat-c5" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="245" y="130" width="30" height="30" as="geometry"/></mxCell><mxCell id="g-combat-c6" value="&lt;b&gt;legal_moves()&lt;/b&gt;  phase == combatMove&lt;br&gt;view() = GameState.from_sim (units carry fm ids)&lt;br&gt;excluded = targets already decided" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="400" height="70" as="geometry"/></mxCell><mxCell id="g-combat-c7" value="&lt;b&gt;enemy_territories_by_priority(game, player)&lt;/b&gt;&lt;br&gt;enemy land territories next to mine, sorted by score: +1000 victory city, +500 per adjacent victory city, +100 × production, +50 per bordering territory of mine, −30 per neighbour with the same owner" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="560" y="180" width="560" height="80" as="geometry"/></mxCell><mxCell id="g-combat-c8" value="next target&lt;br&gt;not in excluded?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="290" width="200" height="90" as="geometry"/></mxCell><mxCell id="g-combat-c9" value="return ([], excluded)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1000" y="305" width="220" height="60" as="geometry"/></mxCell><mxCell id="g-combat-c10" value="&lt;b&gt;get_reachable_units(game, target, player)&lt;/b&gt;&lt;br&gt;my unmoved, mobile, non-sea units in my territories. _reach_routes (BFS) passes only through my territories; land units avoid territories conquered this turn without blitz. Air only if _air_can_land after the attack." style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="560" y="410" width="560" height="85" as="geometry"/></mxCell><mxCell id="g-combat-c11" value="any attacker&lt;br&gt;reaches it?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="525" width="200" height="80" as="geometry"/></mxCell><mxCell id="g-combat-c12" value="excluded.add(target)&lt;br&gt;(pass over)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1000" y="535" width="220" height="60" as="geometry"/></mxCell><mxCell id="g-combat-c13" value="sort attackers by donor_score: +100 if next to the target, +10 × attack&lt;br&gt;def = defender_strength: Σ defense of enemy non-infrastructure units" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="560" y="635" width="560" height="60" as="geometry"/></mxCell><mxCell id="g-combat-c14" value="&lt;b&gt;incremental buildup&lt;/b&gt;: add attackers one at a time; strength = calculate_attack_strength (each supportable infantry paired with an artillery gets +1). Record the set when threshold × def &amp;lt; strength &amp;lt; 3.5 × def + 4 (threshold starts at 1.5, +0.1 after each set)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="560" y="720" width="560" height="80" as="geometry"/></mxCell><mxCell id="g-combat-c15" value="add the full force if its strength &amp;gt; def and it differs from the last set&lt;br&gt;no set and def == 0: the cheapest single reachable unit (capture)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="560" y="825" width="560" height="60" as="geometry"/></mxCell><mxCell id="g-combat-c16" value="&lt;b&gt;return&lt;/b&gt; (actions, excluded ∪ {target})&lt;br&gt;actions = sets strongest first, as CombatAction(to_terr, moves = _group_moves: one MoveAction per route, strength), then skip(target)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="560" y="910" width="560" height="75" as="geometry"/></mxCell><mxCell id="g-combat-c17" value="&lt;b&gt;actions&lt;/b&gt; = [CombatAction(end_phase=True)]&lt;br&gt;no_target → pass_phase" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="400" height="55" as="geometry"/></mxCell><mxCell id="g-combat-c18" value="" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="245" y="380" width="30" height="30" as="geometry"/></mxCell><mxCell id="g-combat-c19" value="&lt;b&gt;actions&lt;/b&gt; = returned list (one tree edge each)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="920" width="400" height="50" as="geometry"/></mxCell><mxCell id="g-combat-c20" value="&lt;b&gt;expand → apply_move(attack)&lt;/b&gt;&lt;br&gt;apply each MoveAction with the forward model (no dice; the battles are fought in the battle phase by fast_battle). A skip applies nothing." style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="1000" width="400" height="80" as="geometry"/></mxCell><mxCell id="g-combat-c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="g-combat-c5" target="g-combat-c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-combat-c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="g-combat-c6" target="g-combat-c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-combat-c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="g-combat-c7" target="g-combat-c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-combat-c24" value="[none left]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="g-combat-c8" target="g-combat-c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-combat-c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;exitX=0.5;exitY=0;entryX=1;entryY=0.25;" edge="1" parent="1" source="g-combat-c9" target="g-combat-c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-combat-c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="g-combat-c17" target="g-combat-c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-combat-c27" value="[target]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="g-combat-c8" target="g-combat-c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-combat-c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="g-combat-c10" target="g-combat-c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-combat-c29" value="[no]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="g-combat-c11" target="g-combat-c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-combat-c30" value="loop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="g-combat-c12" target="g-combat-c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-combat-c31" value="[yes]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="g-combat-c11" target="g-combat-c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-combat-c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="g-combat-c13" target="g-combat-c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-combat-c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="g-combat-c14" target="g-combat-c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-combat-c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="g-combat-c15" target="g-combat-c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-combat-c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="g-combat-c16" target="g-combat-c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-combat-c36" value="child node of the chosen edge" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="g-combat-c19" target="g-combat-c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-combat-c37" value="next legal_moves() (next target)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="g-combat-c20" target="g-combat-c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-combat-c38" value="&lt;b&gt;Branching&lt;/b&gt;&lt;br&gt;Each combat node has the attack sets on one target plus a skip, so a path through the phase decides the targets one at a time in priority order. A skipped target goes into excluded and is not offered again in this phase." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1270" y="120" width="410" height="110" as="geometry"/></mxCell><mxCell id="g-combat-c39" value="&lt;b&gt;Outside the tree&lt;/b&gt;&lt;br&gt;• Rollouts: _rollout_combat calls combat_actions in a loop from the node's excluded set and picks with pick_combat_rollout_move (ε-greedy on strength, or evaluate_state of each option, set by TRIPLEA_MCTS_COMBAT_ROLLOUT).&lt;br&gt;• Answer: play_phase plays the moves of the chosen non-skip edges." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1270" y="250" width="410" height="140" as="geometry"/></mxCell><mxCell id="g-combat-c40" value="&lt;b&gt;Cython&lt;/b&gt;&lt;br&gt;generators.ag is action_generators_cy when it is built (scripts/build_cython.sh), else action_generators.py. Both return the same actions." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1270" y="410" width="410" height="80" as="geometry"/></mxCell><mxCell id="g-combat-c41" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="1270" y="520" width="200" height="20" as="geometry"/></mxCell><mxCell id="g-combat-c42" value="step" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1270" y="544" width="120" height="26" as="geometry"/></mxCell><mxCell id="g-combat-c43" value="actions returned (tree edges)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1400" y="544" width="200" height="26" as="geometry"/></mxCell><mxCell id="g-combat-c44" value="forced moves (not an edge)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1270" y="578" width="200" height="26" as="geometry"/></mxCell><mxCell id="g-combat-c45" value="guard" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1480" y="574" width="90" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="g-noncombat" name="4 Non-combat move action generation"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="g-noncombat-c1" value="Non-combat move: activity diagram from start_phase to finish_phase" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1670" height="30" as="geometry"/></mxCell><mxCell id="g-noncombat-c2" value="The greedy noncombat_move split in three: (1) forced air landings when the phase starts, (2) a search over reinforcements, one territory short of cover per node, (3) positioning moves as the phase ends." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1670" height="36" as="geometry"/></mxCell><mxCell id="g-noncombat-c3" value="HeterogeneousMCTS / HMCTSGameState  (hmcts.py)" style="swimlane;html=1;startSize=28;fillColor=#f8f8f8;strokeColor=#999999;fontStyle=1;fontSize=12;swimlaneFillColor=none;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="500" height="1090" as="geometry"/></mxCell><mxCell id="g-noncombat-c4" value="noncombat_generators  (helpers from generators.ag)" style="swimlane;html=1;startSize=28;fillColor=#f8f8f8;strokeColor=#999999;fontStyle=1;fontSize=12;swimlaneFillColor=none;dashed=1;" vertex="1" parent="1"><mxGeometry x="540" y="90" width="740" height="1090" as="geometry"/></mxCell><mxCell id="g-noncombat-c5" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="255" y="130" width="30" height="30" as="geometry"/></mxCell><mxCell id="g-noncombat-c6" value="&lt;b&gt;start_phase(state)&lt;/b&gt;&lt;br&gt;excluded = {}, moved = {}" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="70" y="180" width="400" height="55" as="geometry"/></mxCell><mxCell id="g-noncombat-c7" value="&lt;b&gt;land_air_moves(game, d, player)&lt;/b&gt;  step 1&lt;br&gt;air that cannot end the phase where it stands flies to the reachable landing spot (_landing_spots) most short of cover; air with no spot is left to be lost, as in the engine" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="580" y="175" width="660" height="70" as="geometry"/></mxCell><mxCell id="g-noncombat-c8" value="apply_moves(forced moves): moved += their units" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="70" y="265" width="400" height="45" as="geometry"/></mxCell><mxCell id="g-noncombat-c9" value="&lt;b&gt;legal_moves()&lt;/b&gt;  phase == nonCombatMove" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="70" y="345" width="400" height="45" as="geometry"/></mxCell><mxCell id="g-noncombat-c10" value="&lt;b&gt;_Plan(game, d, player, moved)&lt;/b&gt;&lt;br&gt;strength[t] = Σ defense_value(u) (1 + 0.5 × defense)&lt;br&gt;want[t] = THREAT_COVER × _enemy_threat[t]; home factory: max(HOME_COVER × threat, HOME_KEEP × army); frontier: at least FRONTIER_MIN&lt;br&gt;movable = combat units not in moved, movement left, land or air" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="580" y="300" width="660" height="100" as="geometry"/></mxCell><mxCell id="g-noncombat-c11" value="targets = my territories not in excluded with shortfall = want − strength &amp;gt; 0, sorted by priority × shortfall (priority: home factory ×1.5, more production higher)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="580" y="425" width="660" height="55" as="geometry"/></mxCell><mxCell id="g-noncombat-c12" value="next target?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="810" y="505" width="200" height="80" as="geometry"/></mxCell><mxCell id="g-noncombat-c13" value="&lt;b&gt;return&lt;/b&gt; [NoncombatAction(end_phase=True, moves = positioning_moves(...))]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1050" y="510" width="210" height="70" as="geometry"/></mxCell><mxCell id="g-noncombat-c14" value="donors: movable units in other territories that can end on the target (land: _reach_routes through my territories; air: _air_routes to a landing spot of mine)&lt;br&gt;score = defense_gain(target) − donor_loss(source), best first" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="580" y="615" width="660" height="70" as="geometry"/></mxCell><mxCell id="g-noncombat-c15" value="&lt;b&gt;incremental buildup&lt;/b&gt;: skip a unit whose source cannot spare it (can_spare); record a set each time the value sent reaches the next COVER_LEVELS share (0.5, 1.0, 1.5) of the shortfall; add 'everything that can be spared' if it differs from the last set.&lt;br&gt;excluded.add(target)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="580" y="710" width="660" height="85" as="geometry"/></mxCell><mxCell id="g-noncombat-c16" value="any set?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="810" y="820" width="200" height="70" as="geometry"/></mxCell><mxCell id="g-noncombat-c17" value="&lt;b&gt;return&lt;/b&gt; (actions, excluded)&lt;br&gt;actions = sets strongest first, as NoncombatAction(to_terr, moves = _group_moves, strength = value sent), then skip(target)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="580" y="920" width="660" height="60" as="geometry"/></mxCell><mxCell id="g-noncombat-c18" value="&lt;b&gt;actions&lt;/b&gt; = returned list (one tree edge each)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="70" y="925" width="400" height="50" as="geometry"/></mxCell><mxCell id="g-noncombat-c19" value="&lt;b&gt;expand → apply_move(reinforcement)&lt;/b&gt;&lt;br&gt;apply_moves(action.moves): moved += units" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="70" y="1010" width="400" height="60" as="geometry"/></mxCell><mxCell id="g-noncombat-c20" value="&lt;b&gt;actions&lt;/b&gt; = [END]  → no_target → pass_phase" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="70" y="510" width="400" height="50" as="geometry"/></mxCell><mxCell id="g-noncombat-c21" value="&lt;b&gt;finish_phase(state)&lt;/b&gt;&lt;br&gt;apply the END action's positioning moves (step 3), then EndPhase" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="70" y="590" width="400" height="60" as="geometry"/></mxCell><mxCell id="g-noncombat-c22" value="" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="255" y="680" width="30" height="30" as="geometry"/></mxCell><mxCell id="g-noncombat-c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="g-noncombat-c5" target="g-noncombat-c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-noncombat-c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="g-noncombat-c6" target="g-noncombat-c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-noncombat-c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="g-noncombat-c7" target="g-noncombat-c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-noncombat-c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="g-noncombat-c8" target="g-noncombat-c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-noncombat-c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="g-noncombat-c9" target="g-noncombat-c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-noncombat-c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="g-noncombat-c10" target="g-noncombat-c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-noncombat-c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="g-noncombat-c11" target="g-noncombat-c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-noncombat-c30" value="[none left]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="g-noncombat-c12" target="g-noncombat-c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-noncombat-c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="g-noncombat-c13" target="g-noncombat-c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-noncombat-c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="g-noncombat-c20" target="g-noncombat-c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-noncombat-c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="g-noncombat-c21" target="g-noncombat-c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-noncombat-c34" value="[target]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="g-noncombat-c12" target="g-noncombat-c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-noncombat-c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="g-noncombat-c14" target="g-noncombat-c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-noncombat-c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="g-noncombat-c15" target="g-noncombat-c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-noncombat-c37" value="[no] pass over" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="g-noncombat-c16" target="g-noncombat-c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-noncombat-c38" value="[yes]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="g-noncombat-c16" target="g-noncombat-c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-noncombat-c39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="g-noncombat-c17" target="g-noncombat-c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-noncombat-c40" value="child node of the chosen edge" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="g-noncombat-c18" target="g-noncombat-c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-noncombat-c41" value="next legal_moves()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="g-noncombat-c19" target="g-noncombat-c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-noncombat-c42" value="&lt;b&gt;positioning_moves(game, d, player, moved)&lt;/b&gt;  step 3&lt;br&gt;Sources farthest from the frontier first. Each unit its source can spare goes to the reachable territory of mine with the best score = defense_gain + advance toward the frontier + 0.2 × max(0, 5 − distance to an objective) − donor_loss, if the score is &amp;gt; 0 and the move gets closer to the frontier." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1310" y="120" width="420" height="150" as="geometry"/></mxCell><mxCell id="g-noncombat-c43" value="&lt;b&gt;Outside the tree&lt;/b&gt;&lt;br&gt;• Rollout from the start of a phase: _rollout_noncombat plays the greedy ag.noncombat_move (the same three steps planned at once).&lt;br&gt;• Rollout of the rest of a phase the tree started: _rollout_rest_of_noncombat takes the first (strongest) action at each territory, then finish_phase.&lt;br&gt;• Answer: play_phase plays the chosen edges' moves, then positioning_moves." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1310" y="290" width="420" height="170" as="geometry"/></mxCell><mxCell id="g-noncombat-c44" value="&lt;b&gt;Same fields as CombatAction&lt;/b&gt;&lt;br&gt;NoncombatAction has to_terr, moves, strength and end_phase, so expand, the metrics and the game records treat both move phases alike." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1310" y="480" width="420" height="80" as="geometry"/></mxCell><mxCell id="g-noncombat-c45" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="1310" y="590" width="200" height="20" as="geometry"/></mxCell><mxCell id="g-noncombat-c46" value="step" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1310" y="614" width="120" height="26" as="geometry"/></mxCell><mxCell id="g-noncombat-c47" value="actions returned (tree edges)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1440" y="614" width="200" height="26" as="geometry"/></mxCell><mxCell id="g-noncombat-c48" value="forced moves (not an edge)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1310" y="648" width="200" height="26" as="geometry"/></mxCell><mxCell id="g-noncombat-c49" value="guard" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1520" y="644" width="90" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
"1" parent="1"><mxGeometry x="330" y="1620" width="250" height="64" as="geometry"/></mxCell><mxCell id="t-sample-c40" value="attack GermanStartRight (s=3.0)&lt;br&gt;1x armour  ⇒ passes the phase on" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;fontStyle=1;strokeWidth=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pv9" target="pv10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t-sample-c41" value="leaf (search time ran out)" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="330" y="1690" width="250" height="20" as="geometry"/></mxCell><mxCell id="t-sample-c42" value="round 1&lt;br&gt;Russians&lt;br&gt;purchase" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="250" height="384" as="geometry"/></mxCell><mxCell id="t-sample-c43" value="round 1&lt;br&gt;Russians&lt;br&gt;combatMove" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="250" height="384" as="geometry"/></mxCell><mxCell id="t-sample-c44" value="round 1&lt;br&gt;Germans&lt;br&gt;purchase" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="1010" width="250" height="234" as="geometry"/></mxCell><mxCell id="t-sample-c45" value="round 1&lt;br&gt;Germans&lt;br&gt;combatMove" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="1310" width="250" height="234" as="geometry"/></mxCell><mxCell id="t-sample-c46" value="round 2&lt;br&gt;Russians&lt;br&gt;purchase" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="1610" width="250" height="84" as="geometry"/></mxCell><mxCell id="t-sample-c47" value="Legend&lt;br&gt;• node fill: who chose the edge into it (its value's point of view) — blue = Russians (me), red = opponent&lt;br&gt;• thick border: the edge ended its player's phase; the node is the next searched decision (next phase, or the next player's)&lt;br&gt;• left bands: the decision a node's children decide (round · player · phase); phases with nothing to decide (here Russians' non-combat move) are passed over&lt;br&gt;• bold column: most-visited child at every level; dashed: its siblings (subtree size shown)&lt;br&gt;• avg = value / visits from the chooser's view; every node uses the same reward (evaluate_state)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="1830" width="1400" height="120" as="geometry"/></mxCell><mxCell id="t-sample-c48" value="sample-tree.html (next to this file) is the full tree of the same search as a collapsible outline; sample-tree.dot is its first 300 nodes for graphviz." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="1970" width="1400" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>

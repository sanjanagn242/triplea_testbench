per"><mxGeometry x="0" y="45" width="360" height="19" as="geometry"/></mxCell><mxCell id="u-classes-c144" value="+ metrics_dir / output_folder" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=wrap;fontSize=10;" vertex="1" parent="helper"><mxGeometry x="0" y="64" width="360" height="19" as="geometry"/></mxCell><mxCell id="u-classes-c145" value="+ log_game_result / turn_position" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=wrap;fontSize=10;" vertex="1" parent="helper"><mxGeometry x="0" y="83" width="360" height="19" as="geometry"/></mxCell><mxCell id="u-classes-c146" value="Edge type by the phase of the parent's state:&lt;br&gt;  purchase       → PurchaseUnit (one unit; candidates from next_unit on)&lt;br&gt;  combatMove     → ag.CombatAction (one target: attack or skip)&lt;br&gt;  nonCombatMove  → ncg.NoncombatAction (one territory: reinforce or skip)&lt;br&gt;END is never an edge: a node whose phase has nothing left to decide is passed on to the next searched decision (passes_phase)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1220" y="800" width="420" height="130" as="geometry"/></mxCell><mxCell id="u-classes-c147" value="Everything the search does to the game goes through apply_in_place: moves, battles (dice), casualties, placement, income, turn order and victory are the forward model's rules. Place is never a tree decision: _place_units plays it." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2140" y="760" width="520" height="70" as="geometry"/></mxCell><mxCell id="u-classes-c148" value="search 1" style="startArrow=diamondThin;startFill=1;startSize=14;endArrow=open;endFill=0;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.08;exitDx=0;exitDy=0;entryX=0;entryY=0.05;entryDx=0;entryDy=0;" edge="1" parent="1" source="TripleMindAgent" target="HeterogeneousMCTS"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="u-classes-c149" value="recorder 0..1" style="startArrow=diamondThin;startFill=1;startSize=14;endArrow=open;endFill=0;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="TripleMindAgent" target="GameRecorder"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="u-classes-c150" value="bridge 0..1" style="endArrow=open;endFill=0;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.02;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="TripleMindAgent" target="fm-bridge"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="540" y="135"/><mxPoint x="540" y="75"/><mxPoint x="2100" y="75"/><mxPoint x="2100" y="165"/></Array></mxGeometry></mxCell><mxCell id="u-classes-c151" value="last_root 0..1" style="endArrow=open;endFill=0;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="HeterogeneousMCTS" target="MCTSNode"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="u-classes-c152" value="children *" style="startArrow=diamondThin;startFill=1;startSize=14;endArrow=open;endFill=0;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="MCTSNode" target="MCTSNode"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="16
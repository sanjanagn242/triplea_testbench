 as="points"><mxPoint x="890" y="900"/></Array></mxGeometry></mxCell><mxCell id="p-legal-c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="p-legal-c19" target="p-legal-c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-legal-c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="p-legal-c20" target="p-legal-c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-legal-c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="p-legal-c21" target="p-legal-c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-legal-c32" value="mcts_search returns forced + played: for a non-combat move the forced air landings, the chosen reinforcements and the positioning moves; agent.encode turns them into the engine's action object." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1100" y="740" width="420" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p-eval" name="6 evaluate_state"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p-eval-c1" value="6 · evaluate_state(state, whoAmI, depth, depth_budget) — the one reward" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1220" height="30" as="geometry"/></mxCell><mxCell id="p-eval-c2" value="Used for every rollout, whichever phase and player the leaf belongs to." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1220" height="40" as="geometry"/></mxCell><mxCell id="p-eval-c3" value="evaluate_state" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="270.0" y="100" width="380" height="50" as="geometry"/></mxCell><mxCell id="p-eval-c4" value="sim.terminal?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="360.0" y="180" width="200" height="80" as="geometry"/></mxCell><mxCell id="p-eval-c5" value="whoAmI's alliance in winners?&lt;br&gt;win: 0.5 + 0.5 · (budget − depth) / budget&lt;br&gt;loss: −0.5 − 0.5 · (budget − depth) / budget&lt;br&gt;(is_terminal = True)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="760" y="175" width="400" height="90" as="geometry"/></mxCell><mxCell id="p-eval-c6" value="for each territory (view):&lt;br&gt;income += production if owner is whoAmI;&lt;br&gt;income_denom += production (not neutral)&lt;br&gt;my_tuv / enemy_tuv += unit cost (no infrastructure)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="270.0" y="310" width="380" height="100" as="geometry"/></mxCell><mxCell id="p-eval-c7" value="score = ½ · my_tuv / (my_tuv + enemy_tuv) + ½ · income / income_denom" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="270.0" y="460" width="380" height="60" as="geometry"/></mxCell><mxCell id="p-eval-c8" value="return score − 0.5  (in [−0.5, 0.5]), is_terminal = False" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="270.0" y="560" width="380" height="50" as="geometry"/></mxCell><mxCell id="p-eval-c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="p-eval-c3" target="p-eval-c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-eval-c10" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="p-eval-c4" target="p-eval-c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-eval-c11" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="p-eval-c4" target="p-eval-c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-eval-c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="p-eval-c6" target="p-eval-c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-eval-c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="p-eval-c7" target="p-eval-c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>

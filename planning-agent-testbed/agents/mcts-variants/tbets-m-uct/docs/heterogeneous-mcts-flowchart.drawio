vertex="1" parent="1"><mxGeometry x="230.0" y="580" width="380" height="50" as="geometry"/></mxCell><mxCell id="p-legal-c16" value="state = initial_state.clone(); played = []" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="230.0" y="660" width="380" height="50" as="geometry"/></mxCell><mxCell id="p-legal-c17" value="for each chosen edge: played += edge's fm actions&lt;br&gt;(purchase: PurchaseAction; combat: moves of real attacks; non-combat: moves)&lt;br&gt;state.apply_move(edge)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="230.0" y="740" width="380" height="80" as="geometry"/></mxCell><mxCell id="p-legal-c18" value="state.phase?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="320.0" y="860" width="200" height="80" as="geometry"/></mxCell><mxCell id="p-legal-c19" value="purchase: spend the rest greedily&lt;br&gt;(most attack + defense per PU),&lt;br&gt;appended to last_choice" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="990" width="300" height="80" as="geometry"/></mxCell><mxCell id="p-legal-c20" value="nonCombatMove:&lt;br&gt;legal_moves(); played += positioning moves" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="400" y="990" width="300" height="80" as="geometry"/></mxCell><mxCell id="p-legal-c21" value="combatMove: nothing more&lt;br&gt;(an unchosen target is not attacked)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="740" y="990" width="300" height="80" as="geometry"/></mxCell><mxCell id="p-legal-c22" value="return played" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" 
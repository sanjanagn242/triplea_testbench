/><mxPoint x="330" y="1245"/></Array></mxGeometry></mxCell><mxCell id="p-mcts-c38" value="yes: roll out from child" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p-mcts-c12" target="p-mcts-c14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="1025"/><mxPoint x="800" y="1245"/></Array></mxGeometry></mxCell><mxCell id="p-mcts-c39" value="no: node had nothing left" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="p-mcts-c12" target="p-mcts-c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-mcts-c40" value="yes: walk on" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p-mcts-c13" target="p-mcts-c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="280" y="1135"/><mxPoint x="280" y="720"/></Array></mxGeometry></mxCell><mxCell id="p-mcts-c41" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="p-mcts-c13" target="p-mcts-c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-mcts-c42" value="next iteration" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p-mcts-c15" target="p-mcts-c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="860" y="1330"/><mxPoint x="860" y="550"/><mxPoint x="560" y="550"/></Array></mxGeometry></mxCell><mxCell id="p-mcts-c43" value="Every node, whoever's decision and whatever phase, is valued by the same reward (evaluate_state, whoAmI's view); each node stores it × sign, the view of the player who chose its edge, so UCT maximises for whoever chooses at the parent." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1000" y="1110" width="380" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p-expand" name="3 expand &amp; pass_phase"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p-expand-c1" value="3 · expand(node) → pass_phase → advance → start_phase" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1820" height="30" as="geometry"/></mxCell><mxCell id="p-expand-c2" value="How one tree crosses phases and players: when a phase has nothing left to decide, the child is moved on to the next searched decision, whoever's it is." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1820" height="40" as="geometry"/></mxCell><mxCell id="p-expand-c3" value="expand(node)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250.0" y="100" width="340" height="50" as="geometry"/></mxCell><mxCell id="p-expand-c4" value="action = node.state.getNextAction()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="250.0" y="180" width="340" height="50" as="geometry"/></mxCell><mxCell id="p-expand-c5" value="action None or END?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="310.0" y="260" width="220" height="80" as="geometry"/></mxCell><mxCell id="p-expand-c6" value="node.untried_actions = []&lt;br&gt;return node (fully expanded)" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=15;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="700" y="270" width="260" height="60" as="geometry"/></mxCell><mxCell id="p-expand-c7" value="new_state = clone; played_by = node's next_moves_by&lt;br&gt;new_state.apply_move(action)&lt;br&gt;purchase: buy 1 unit, next_unit = its index&lt;br&gt;moves: apply MoveActions (moved += units)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="250.0" y="380" width="340" height="90" as="geometry"/></mxCell><mxCell id="p-expand-c8" value="new_state.legal_moves()  (page 5)" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.06;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250.0" y="510" width="340" height="50" as="geometry"/></mxCell><mxCell id="p-expand-c9" value="no_target(new_state)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="310.0" y="590" width="220" height="80" as="geometry"/></mxCell><mxCell id="p-expand-c10" value="pass_phase(new_state)" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.06;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250.0" y="720" width="340" height="50" as="geometry"/></mxCell><mxCell id="p-expand-c11" value="child = MCTSNode(new_state, sign = sign_of(played_by))&lt;br&gt;child.passes_phase = no_target&lt;br&gt;node.children.append(child); return child" style="rounded=0;whiteSpac
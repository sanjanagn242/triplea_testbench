in_place,&lt;br&gt;validate, SeededRng" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.2;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="search" target="kernel"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="classes-c89" value="reads command" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="engine" target="manifest"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="classes-c90" value="starts process" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="engine" target="launcher"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="classes-c91" value="exec" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="launcher" target="module"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="classes-c92" value="Open-loop MCTS over the rest of the current phase: tree edges are this player's actions (toolkit candidates ordered by HeuristicPolicy.prior, progressive widening). Each iteration replays the edges on a clone with fresh dice, rolls everyone out with HeuristicPolicy for rollout_rounds rounds and backs up evaluate(). The answer is the most-visited path, completed greedily by the policy." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fontSize=10;fillColor=#fffbe6;strokeColor=#b3a14d;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="400" height="98.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="sequence" name="2 Sequence — one decision"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1236" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sequence-c1" value="Python MCTS — sequence of game_start and one phase request" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1600" height="30" as="geometry"/></mxCell><mxCell id="sequence-c2" value="Solid arrows = calls, dashed = returns. fm = triplea_fm kernel API." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1900" height="34" as="geometry"/></mxCell><mxCell id="sequence-ll-engine" value="TripleA engine" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="180" height="1076" as="geometry"/></mxCell><mxCell id="sequence-ll-agent" value=":Agent" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="315" y="100" width="180" height="1076" as="geometry"/></mxCell><mxCell id="sequence-ll-bridge" value=":LiveBridge" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="570" y="100" width="180" height="1076" as="geometry"/></mxCell><mxCell id="sequence-ll-search" value=":PhaseSearch" styl
<mxfile host="app.diagrams.net" type="device"><diagram id="tmh-classes" name="1 Class diagram — the TripleMind family"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2220" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tmh-classes-c1" value="TripleMind hybrids — class diagram: the original MCTS agent, tripleMind-bc and tripleMind-PPO" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1800" height="30" as="geometry"/></mxCell><mxCell id="tmh-classes-c2" value="Blue = agent classes · green = pipeline / model classes · purple = data containers · yellow = modules and free functions · orange = triplea_fm forward model / PyTorch · grey = TripleMind, engine, CLI, files." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1800" height="20" as="geometry"/></mxCell><mxCell id="tmh-classes-c3" value="◆ composition (owns)   ◇ aggregation (holds a reference)   ▷ generalization   dashed ▷ realization   dashed → dependency (uses / creates)" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1800" height="20" as="geometry"/></mxCell><mxCell id="tmh-classes-c4" value="«agents/tripleMind/agent.py · id tripleMind-mcts»&lt;br&gt;&lt;b&gt;TripleMindAgent&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;startSize=42;html=1;whiteSpace=wrap;childLayout=stackLayout;horizontal=1;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="420" height="230" as="geometry"/></mxCell><mxCell id="tmh-classes-c5" value="+ whoAmI, definition, b
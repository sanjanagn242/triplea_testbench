"1" parent="1" source="tmh-classes-c74" target="tmh-classes-c70"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tmh-classes-e97" value="features" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;verticalAlign=bottom;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="tmh-classes-c57" target="tmh-classes-c78"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1640" y="427.0"/><mxPoint x="1640" y="807.0"/></Array></mxGeometry></mxCell><mxCell id="tmh-classes-e98" value="features (DecisionEncoder)" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;verticalAlign=bottom;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="tmh-classes-c62" target="tmh-classes-c78"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1625" y="577.0"/><mxPoint x="1625" y="807.0"/></Array></mxGeometry></mxCell><mxCell id="tmh-classes-n99" value="Every variant plays the same game: TripleMind's map graph, purchase, target heuristic, noncombat moves and placement. They differ only in how the attack formation for each heuristic target is chosen: MCTS search (tripleMind-mcts), a behaviour-cloned scorer (tripleMind-bc) or a PPO policy learned from scratch (tripleMind-ppo). BC and PPO share the candidate features and the CandidateScorer architecture, not weights." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="580" y="700" width="440" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="tmh-components" name="2 Components and data flow"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tmh-components-c1" value="TripleMind hybrids — components (folders) and data flow" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1800" height="30" as="geometry"/></mxCell><mxCell id="tmh-components-c2" value="Thick arrows = data / artefacts · dashed arrows = code reuse (imports / subclass, nothing copied) · thin arrows = launch / protocol" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1800" height="20" as="geometry"/></mxCell><mxCell id="tmh-components-c3" value="planning-agent-testbed (testbench)" style="swimlane;startSize=26;html=1;whiteSpace=wrap;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="360" height="560" as="geometry"/></mxCell><mxCell id="tmh-components-c4" value="&lt;b&gt;Java testbench&lt;/b&gt;&lt;br&gt;Planning Agent Testbench → Run Simulations&lt;br&gt;ExternalAgentPlayer, agents.json" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="320" height="80" as="geometry"/></mxCell><mxCell id="tmh-components-c5" value="&lt;b&gt;tools/arena.py&lt;/b&gt; play_game&lt;br&gt;forward model stands in for the engine; agents are commands or in-process objects (PPO rollouts)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="320" height="80" as="geometry"/></mxCell><mxCell id="tmh-components-c6" value="NDJSON protocol over stdin / stdout: game_start · turn_request(phase, state) · game_end; launches each agent's run-agent.sh" style="rounde
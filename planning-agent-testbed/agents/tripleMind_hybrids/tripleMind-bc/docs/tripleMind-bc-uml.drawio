0;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="960" y="100" width="180" height="856" as="geometry"/></mxCell><mxCell id="tmbc-combat-seq-c30" value="attack_formation_dataset&lt;br&gt;(feature functions)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1190" y="100" width="180" height="856" as="geometry"/></mxCell><mxCell id="tmbc-combat-seq-c31" value=":CandidateScorer" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1420" y="100" width="180" height="856" as="geometry"/></mxCell><mxCell id="tmbc-combat-seq-c32" value="triplea_fm" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1650" y="100" width="180" height="856" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="tmbc-arch" name="4 Neural network — CandidateScorer (policy)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tmbc-arch-c0" value="Neural network — CandidateScorer architecture (bc_baseline/model.py; runs/mlp-baseline/best.pt)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1600" height="30" as="geometry"/></mxCell><mxCell id="tmbc-arch-c1" value="Grey = inputs · yellow = fixed operations (no parameters) · green = trainable layers · purple = intermediate tensors · orange = outputs. B = decisions in the batch, C = candidates (padded to the batch's largest set). Defaults: hidden_dims [256, 128], dropout 0.1." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1700" height="34" as="geometry"/></mxCell><mxCell id="tmbc-arch-c2" value="&lt;b&gt;node&lt;/b&gt;&lt;br&gt;(B, 29, 45)&lt;br&gt;territory features" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="180" height="60" as="geometry"/></mxCell><mxCell id="tmbc-arch-c3" value="&lt;b&gt;glob&lt;/b&gt;&lt;br&gt;(B, 3)&lt;br&gt;round, own / opp income" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="180" height="60" as="geometry"/></mxCell><mxCell id="tmbc-arch-c4" value="&lt;b&gt;cand&lt;/b&gt;&lt;br&gt;(B, C, 94)&lt;br&gt;candidate features" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="180" height="60" as="geometry"/></mxCell><mxCell id="tmbc-arch-c5" value="&lt;b&gt;mask&lt;/b&gt;&lt;br&gt;(B, C) bool&lt;br&gt;True = real candidate" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1240" y="830" width="200" height="60" as="geometry"/></mxCell><mxCell id="tmbc-arch-c6" value="&lt;b&gt;flatten_state&lt;/b&gt;&lt;br&gt;node.flatten → (B, 1305)&lt;br&gt;‖ glob → &lt;b&gt;(B, 1308)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="270" y="150" width="200" height="80" as="geometry"/></mxCell><mxCell id="tmbc-arch-c7" value="&lt;b&gt;Standardizer&lt;/b&gt; (state)&lt;br&gt;(x − mean) / std&lt;br&gt;buffers fitted on train split" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="520" y="150" width="200" height="80" as="geometry"/></mxCell><mxCell id="tmbc-arch-c8" value="&lt;b&gt;Linear 1308 → 256&lt;/b&gt;&lt;br&gt;ReLU · Dropout 0.1&lt;br&gt;335,104 params&lt;br&gt;state_encoder[0:3]" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="770" y="140" width="210" height="100" as="geometry"/></mxCell><mxCell id="tmbc-arch-c9" value="&lt;b&gt;Linear 256 → 128&lt;/b&gt;&lt;br&gt;ReLU · Dropout 0.1&lt;br&gt;32,896 params&lt;br&gt;state_encoder[3:6]" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1030" y="140" width="210" height="100" as="geometry"/></mxCell><mxCell id="tmbc-arch-c10" value="&lt;b&gt;s&lt;/b&gt;  (B, 128)&lt;br&gt;state embedding" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1290" y="155" width="170" height="70" as="geometry"/></mxCell><mxCell id="tmbc-arch-c11" value="&lt;b&gt;expand&lt;/b&gt;&lt;br&gt;s → (B, C, 128)&lt;br&gt;same s for every candidate" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1290" y="300" width="170" height="70" as="geometry"/></mxCell><mxCell id="tmbc-arch-c12" value="&lt;b&gt;Standardizer&lt;/b&gt; (cand)&lt;br&gt;(x − mean) / std&lt;br&gt;over real train candidates" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="520" y="460" width="200" height="80" as="geometry"/></mxCell><mxCell id="tmbc-arch-c13" value="&lt;b&gt;Linear 94 → 128&lt;/b&gt;&lt;br&gt;ReLU · Dropout 0.1&lt;br&gt;12,160 params&lt;br&gt;cand_encoder (per candidate)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="770" y="450" width="210" height="100" as="geometry"/></mxCell><mxCell id="tmbc-arch-c14" value="&lt;b&gt;c&lt;/b&gt;  (B, C, 128)&lt;br&gt;candidate embeddings" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1030" y="465" width="170" height="70" as="geometry"/></mxCell><mxCell id="tmbc-arch-c15" value="&lt;b&gt;concat&lt;/b&gt; [s, c]&lt;br&gt;(B, C, 256)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1290" y="450" width="170" height="80" as="geometry"/></mxCell><mxCell id="tmbc-arch-c16" value="&lt;b&gt;Linear 256 → 128&lt;/b&gt;&lt;br&gt;ReLU · Dropout 0.1&lt;br&gt;32,896 params&lt;br&gt;scorer[0:3] (per candidate)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1520" y="440" width="230" height="100" as="geometry"/></mxCell><mxCell id="tmbc-arch-c17" value="&lt;b&gt;Linear 128 → 1&lt;/b&gt;&lt;br&gt;129 params&lt;br&gt;scorer[3]  → squeeze" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1520" y="590" width="230" height="90" as="geometry"/></mxCell><mxCell id="tmbc-arch-c18" value="&lt;b&gt;scores&lt;/b&gt;  (B, C)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1520" y="720" width="230" height="60" as="geometry"/></mxCell><mxCell id="tmbc-arch-c19" value="&lt;b&gt;masked_fill&lt;/b&gt;(~mask, −1e9)&lt;br&gt;padding → MASKED" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1520" y="820" width="230" height="80" as="geometry"/></mxCell><mxCell id="tmbc-arch-c20" value="&lt;b&gt;softmax over C&lt;/b&gt;&lt;br&gt;π(candidate | state)&lt;br&gt;Σ = 1, 0 on padding (check 3)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1520" y="950" width="230" height="80" as="geometry"/></mxCell><mxCell id="tmbc-arch-c21" value="&lt;b&gt;Training&lt;/b&gt;: cross_entropy(scores, expert_index)&lt;br&gt;Adam on the training split only" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1180" y="1080" width="280" height="80" as="geometry"/></mxCell><mxCell id="tmbc-arch-c22" value="&lt;b&gt;Evaluation&lt;/b&gt;: predict → argmax&lt;br&gt;vs expert; baselines" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1520" y="1080" width="230" height="80" as="geometry"/></mxCell><mxCell id="tmbc-arch-c23" value="&lt;b&gt;tripleMind-bc&lt;/b&gt;: BCPolicy.choose&lt;br&gt;argmax → generator index (B = 1)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1180" y="960" width="280" height="80" as="geometry"/></mxCell><mxCell id="tmbc-arch-e24" value="" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="tmbc-arch-c2" target="tmbc-arch-c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tmbc-arch-e25" value="" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="tmbc-arch-c3" target="tmbc-arch-c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tmbc-arch-e26" value="" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="tmbc-arch-c6" target="tmbc-arch-c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tmbc-arch-e27" value="(B, 1308)" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="tmbc-arch-c7" target="tmbc-arch-c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tmbc-arch-e28" value="(B, 256)" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="tmbc-arch-c8" target="tmbc-arch-c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tmbc-arch-e29" value="" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="tmbc-arch-c9" target="tmbc-arch-c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tmbc-arch-e30" value="" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="tmbc-arch-c10" target="tmbc-arch-c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tmbc-arch-e31" value="" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="tmbc-arch-c4" target="tmbc-arch-c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tmbc-arch-e32" value="(B, C, 94)" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="tmbc-arch-c12" target="tmbc-arch-c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tmbc-arch-e33" value="" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="tmbc-arch-c13" target="tmbc-arch-c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tmbc-arch-e34" value="" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="tmbc-arch-c11" target="tmbc-arch-c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tmbc-arch-e35" value="" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="tmbc-arch-c14" target="tmbc-arch-c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tmbc-arch-e36" value="" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="tmbc-arch-c15" target="tmbc-arch-c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tmbc-arch-e37" value="(B, C, 128)" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="tmbc-arch-c16" target="tmbc-arch-c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tmbc-arch-e38" value="" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="tmbc-arch-c17" target="tmbc-arch-c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tmbc-arch-e39" value="" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="tmbc-arch-c18" target="tmbc-arch-c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tmbc-arch-e40" value="mask" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="tmbc-arch-c5" target="tmbc-arch-c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tmbc-arch-e41" value="" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="tmbc-arch-c19" target="tmbc-arch-c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tmbc-arch-e42" value="" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="tmbc-arch-c20" target="tmbc-arch-c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tmbc-arch-e43" value="" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="tmbc-arch-c20" target="tmbc-arch-c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tmbc-arch-e44" value="" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="tmbc-arch-c19" target="tmbc-arch-c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tmbc-arch-c45" value="&lt;b&gt;Parameters&lt;/b&gt; (hidden_dims [256, 128])&lt;br&gt;state_encoder 335,104 + 32,896&lt;br&gt;cand_encoder 12,160&lt;br&gt;scorer 32,896 + 129&lt;br&gt;&lt;b&gt;total 413,185&lt;/b&gt; (+ 2,804 standardizer buffers, not trained)" style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=10;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="420" height="170" as="geometry"/></mxCell><mxCell id="tmbc-arch-c46" value="&lt;b&gt;Why it handles any number of candidates&lt;/b&gt;&lt;br&gt;cand_encoder and scorer are applied to each candidate with the same weights, and the state embedding s is copied to every candidate, so the scores are permutation-equivariant over candidates and C can vary per decision; padding is removed by the mask before the softmax. Candidates never see each other (no attention / pooling over candidates) — each is scored against the state alone." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=10;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="500" y="820" width="560" height="170" as="geometry"/></mxCell><mxCell id="tmbc-arch-c47" value="&lt;b&gt;Shapes come from the data&lt;/b&gt;: 29 territories × 45 node features, 3 global and 94 candidate features (feature_names.json); state_dim = 29·45 + 3 = 1308. &lt;b&gt;Configurable&lt;/b&gt;: --hidden-dims h1 … hk gives state_encoder 1308 → h1 → … → hk; cand_encoder 94 → hk; scorer 2·hk → hk → 1; --dropout. The checkpoint stores this as model_config, and CandidateScorer.from_config rebuilds it." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=10;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="1030" width="1020" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>

 width="200" height="90" as="geometry"/></mxCell><mxCell id="activity-c9" value="expand: child = node.state.child(); child.apply(action)&lt;br&gt;(move units by route / skip / Advance: end phase, battles, next move phase);&lt;br&gt;child.generate_actions()" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1000" y="410" width="420" height="80" as="geometry"/></mxCell><mxCell id="activity-c10" value="select: node = child with the highest Q / N&lt;br&gt;(no exploration; also at the opponent's levels)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="620" y="560" width="340" height="60" as="geometry"/></mxCell><mxCell id="activity-c11" value="playout(clone of the node's state): up to 40 times, the acting player's Weak AI&lt;br&gt;moves (capital blitz, walk in, &gt; 1.1x attacks / step towards the enemy capital),&lt;br&gt;then advance; battles = Fast-AI most likely outcome (no dice)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="120" y="660" width="480" height="80" as="geometry"/></mxCell><mxCell id="activity-c12" value="reward: win 0.6 + 0.4 (40 − phases)/40, loss the negative,&lt;br&gt;otherwise (own − others) / (2.5 · all units)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="120" y="770" width="480" height="60" as="geometry"/></mxCell><mxCell id="activity-c13" value="backpropagate: N += 1, Q += reward on every node up to the root" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="120" y="860" width="480" height="50" as="geometry"/></mxCell><mxCell id="activity-c14" value="plan: from the root take the child with the highest Q / N until an Advance;&lt;br&gt;keep the territory actions, drop the skips" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="820" y="210" width="440" height="60" as="geometry"/></mxCell><mxCell id="activity-c15" value="Agent.routes: route every unit from where it stands, merge equal routes;&lt;br&gt;LiveBridge.move_to_json" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="820" y="300" width="440" height="50" as="geometry"/></mxCell><mxCell id="activity-c16" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1025" y="370" width="30" height="30" as="geometry"/></mxCell><mxCell id="activity-c17" value="" style="endArrow=block;endFill=1;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="activity-c3" target="activity-c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="activity-c18" value="" style="endArrow=block;endFill=1;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="activity-c4" target="activity-c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="activity-c19" value="yes" style="endArrow=block;endFill=1;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="activity-c5" target="activity-c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="activity-c20" value="no" style="endArrow=block;endFill=1;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="activity-c5" target="activity-c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="activity-c21" value="" style="endArrow=block;endFill=1;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="activity-c6" target="activity-c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="activity-c22" value="no (depth += 1)" style="endArrow=block;endFill=1;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="activity-c7" target="activity-c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="activity-c23" value="yes" style="endArrow=block;endFill=1;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="activity-c7" target="activity-c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="activity-c24" value="yes" style="endArrow=block;endFill=1;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="activity-c8" target="activity-c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="activity-c25" value="no" style="endArrow=block;endFill=1;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="activity-c8" target="activity-c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="activity-c26" value="" style="endArrow=block;endFill=1;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="activity-c10" target="activity-c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="activity-c27" value="" style="endArrow=block;endFill=1;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="activity-c9" target="activity-c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="activity-c28" value="" style="endArrow=block;endFill=1;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="activity-c11" target="activity-c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="activity-c29" value="" style="endArrow=block;endFill=1;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="activity-c12" target="activity-c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="activity-c30" value="next iteration" style="endArrow=block;endFill=1;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="activity-c13" target="activity-c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="activity-c31" value="" style="endArrow=block;endFill=1;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="activity-c14" target="activity-c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="activity-c32" value="" style="endArrow=block;endFill=1;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="activity-c15" target="activity-c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="activity-c33" value="A node expands all its actions (one playout each) before selection passes through it. Combat actions: unit sets of getUnitsUpToStrengthSet for the next enemy territory it can take, then skip. Noncombat actions: every non-empty combination of unit groups for the next own territory, then skip. No territory left: Advance." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fontSize=10;fillColor=#fffbe6;strokeColor=#b3a14d;" vertex="1" parent="1"><mxGeometry x="1040" y="560" width="440" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>

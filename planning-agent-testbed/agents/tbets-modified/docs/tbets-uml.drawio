<mxfile host="app.diagrams.net" type="device"><diagram id="run" name="1 Activity — run(): one search"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="run-c1" value="TBETS.run(root_state) — one search (one purchase, combat move or noncombat move)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="30" as="geometry"/></mxCell><mxCell id="run-c2" value="Activity diagram. Blue = steps, green = calls drawn on other pages, yellow = decisions. Every node of the tree is a whole genome; its edges are one-gene mutations." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1400" height="40" as="geometry"/></mxCell><mxCell id="run-c3" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="405" y="100" width="30" height="30" as="geometry"/></mxCell><mxCell id="run-c4" value="&lt;b&gt;_setup(root_state)&lt;/b&gt;&lt;br&gt;empty caches: values (per genome), attack sets" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="260" y="160" width="320" height="60" as="geometry"/></mxCell><mxCell id="run-c5" value="&lt;b&gt;greedy_genome(deadline)&lt;/b&gt; (φ, Greedy Action AI)&lt;br&gt;evaluate(()) decodes every segment from nothing; if it has this turn's combat segment, each target in priority order keeps the option (attack sets, then skip) whose genome evaluates best" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="260" y="250" width="320" height="100" as="geometry"/></mxCell><mxCell id="run-c6" value="&lt;b&gt;root ← make_node(genes)&lt;/b&gt;&lt;br&gt;evaluate(genes) → (value, decoded genome, turns)&lt;br&gt;root.visits ← 1, root.value ← value" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="260" y="380" width="320" height="80" as="geometry"/></mxCell><mxCell id="run-c7" value="&lt;b&gt;root.untried ← mutations(root)&lt;/b&gt;&lt;br&gt;every one-gene change of my segments, shuffled" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="260" y="490" width="320" height="60" as="geometry"/></mxCell><mxCell id="run-c8" value="root.untried&lt;br&gt;empty?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="320" y="580" width="200" height="90" as="geometry"/></mxCell><mxCell id="run-c9" value="phase ← 0&lt;br&gt;phase_seconds ← time left / EMCTS_PHASES" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="260" y="710" width="320" height="60" as="geometry"/></mxCell><mxCell id="run-c10" value="phase &amp;lt; EMCTS_PHASES?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="320" y="800" width="200" height="90" as="geometry"/></mxCell><mxCell id="run-c11" value="&lt;b&gt;while now &amp;lt; phase_end:&lt;/b&gt;&lt;br&gt;iterate(root)  (page 2)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="260" y="930" width="320" height="60" as="geometry"/></mxCell><mxCell id="run-c12" value="root.children&lt;br&gt;empty?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="320" y="1020" width="200" height="90" as="geometry"/></mxCell><mxCell id="run-c13" value="&lt;b&gt;root ← most_promising(root)&lt;/b&gt;&lt;br&gt;most visits, then best mean: burn the bridges to the other children; path.append(root); phase += 1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="260" y="1150" width="320" height="70" as="geometry"/></mxCell><mxCell id="run-c14" value="&lt;b&gt;return (root.genes[0], root.turns[0])&lt;/b&gt;&lt;br&gt;the played genome's first segment (this phase) and its Turn; stats: best value, nodes" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="730" y="1035" width="340" height="60" as="geometry"/></mxCell><mxCell id="run-c15" value="" style="ellipse;html=1;shape=doubleEllipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="885" y="1150" width="30" height="30" as="geometry"/></mxCell><mxCell id="run-c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="run-c3" target="run-c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="run-c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="run-c4" target="run-c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="run-c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="run-c5" target="run-c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="run-c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="run-c6" target="run-c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="run-c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="run-c7" target="run-c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="run-c21" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="run-c8" target="run-c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="run-c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="run-c9" target="run-c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="run-c23" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="run-c10" target="run-c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="run-c24" value="phase_end reached" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="run-c11" target="run-c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="run-c25" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="run-c12" target="run-c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="run-c26" value="next phase" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="run-c13" target="run-c10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="220" y="1185"/><mxPoint x="220" y="845"/></Array></mxGeometry></mxCell><mxCell id="run-c27" value="yes: the greedy genome is the only one" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="run-c8" target="run-c14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="625"/></Array></mxGeometry></mxCell><mxCell id="run-c28" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="run-c10" target="run-c14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="845"/></Array></mxGeometry></mxCell><mxCell id="run-c29" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="run-c12" target="run-c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="run-c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="run-c14" target="run-c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="run-c31" value="&lt;b&gt;Bridge burning&lt;/b&gt;&lt;br&gt;The search time is split into EMCTS_PHASES equal phases. After each, the root moves to its most visited child and the other children are never searched again (they stay in the tree, so backups still reach the first root). The played genome is the root after the last phase." style="shape=note;whiteSpace=wrap;html=1;fontSize=10;size=14;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1110" y="640" width="330" height="120" as="geometry"/></mxCell><mxCell id="run-c32" value="&lt;b&gt;Genome&lt;/b&gt;&lt;br&gt;Segments with markers (phase, turn, player): my purchase / combat / noncombat with genes, and a gene-less 'other' marker per other player's greedy turn, up to EMCTS_HORIZON turns after this one. The node stores the decoded genome, so lengths differ per node." style="shape=note;whiteSpace=wrap;html=1;fontSize=10;size=14;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="700" y="250" width="360" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="iterate" name="2 Activity — iterate(root): one iteration"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="iterate-c1" value="TBETS.iterate(root) — one iteration (selection, expansion, evaluation, backpropagation)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="30" as="geometry"/></mxCell><mxCell id="iterate-c2" value="Activity diagram. The tree is grown from the current root (after bridge burning); the backup runs up to the first root." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1400" height="40" as="geometry"/></mxCell><mxCell id="iterate-c3" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="405" y="100" width="30" height="30" as="geometry"/></mxCell><mxCell id="iterate-c4" value="&lt;b&gt;node ← root&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="260" y="160" width="320" height="40" as="geometry"/></mxCell><mxCell id="iterate-c5" value="node.untried&lt;br&gt;is None?&lt;br&gt;(first visit)" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="320" y="240" width="200" height="90" as="geometry"/></mxCell><mxCell id="iterate-c6" value="&lt;b&gt;node.untried ← mutations(node)&lt;/b&gt;&lt;br&gt;for each segment k of node.genes / node.turns:&lt;br&gt;• combat: gene i → options(turn, genes, i): attack sets from units the other genes leave free, skip&lt;br&gt;• purchase / noncombat: gene i → turn.choices[i] (candidate units / reinforcement sets, skip)&lt;br&gt;• other: no genes, never mutated&lt;br&gt;keep a ≠ current gene; shuffle" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="610" y="220" width="420" height="130" as="geometry"/></mxCell><mxCell id="iterate-c7" value="node.untried&lt;br&gt;non-empty?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="320" y="400" width="200" height="90" as="geometry"/></mxCell><mxCell id="iterate-c8" value="&lt;b&gt;expand(node)&lt;/b&gt;&lt;br&gt;(k, i, a) ← node.untried.pop()&lt;br&gt;genes′ ← node.genes with segment k's gene i = a&lt;br&gt;child, v ← make_node(genes′, node, mutation)  → evaluate(genes′)  (page 3)&lt;br&gt;node.children.append(child); node ← child" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="230" y="540" width="380" height="110" as="geometry"/></mxCell><mxCell id="iterate-c9" value="node.children&lt;br&gt;empty?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="720" y="400" width="200" height="90" as="geometry"/></mxCell><mxCell id="iterate-c10" value="&lt;b&gt;v ← evaluate(node.genes)&lt;/b&gt;&lt;br&gt;no mutation at all: cached value" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="670" y="555" width="300" height="60" as="geometry"/></mxCell><mxCell id="iterate-c11" value="&lt;b&gt;node ← select(node)&lt;/b&gt;&lt;br&gt;UCB1: argmax mean + C·√(ln N / n)&lt;br&gt;(C = EMCTS_EXP_CONST, default 0; ties at random). Every mutation is mine: always maximise" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1030" y="400" width="300" height="90" as="geometry"/></mxCell><mxCell id="iterate-c12" value="&lt;b&gt;backpropagate v&lt;/b&gt;&lt;br&gt;while node: node.visits += 1; node.value += v; node ← node.parent&lt;br&gt;(through the burned path up to the first root)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="230" y="750" width="380" height="70" as="geometry"/></mxCell><mxCell id="iterate-c13" value="stats.max_depth ← max(max_depth, node.depth)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="230" y="680" width="380" height="36" as="geometry"/></mxCell><mxCell id="iterate-c14" value="" style="ellipse;html=1;shape=doubleEllipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="405" y="860" width="30" height="30" as="geometry"/></mxCell><mxCell id="iterate-c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="iterate-c3" target="iterate-c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="iterate-c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="iterate-c4" target="iterate-c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="iterate-c17" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="iterate-c5" target="iterate-c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="iterate-c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="iterate-c6" target="iterate-c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="820" y="380"/><mxPoint x="420" y="380"/></Array></mxGeometry></mxCell><mxCell id="iterate-c19" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="iterate-c5" target="iterate-c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="iterate-c20" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="iterate-c7" target="iterate-c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="iterate-c21" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="iterate-c7" target="iterate-c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="iterate-c22" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="iterate-c9" target="iterate-c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="iterate-c23" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="iterate-c9" target="iterate-c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="iterate-c24" value="descend" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="iterate-c11" target="iterate-c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1180" y="190"/><mxPoint x="570" y="190"/></Array></mxGeometry></mxCell><mxCell id="iterate-c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="iterate-c8" target="iterate-c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="iterate-c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="iterate-c10" target="iterate-c13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="820" y="698"/></Array></mxGeometry></mxCell><mxCell id="iterate-c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="iterate-c13" target="iterate-c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="iterate-c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="iterate-c12" target="iterate-c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="iterate-c29" value="&lt;b&gt;Value&lt;/b&gt;&lt;br&gt;v is evaluate_state of the state reached by decoding the genome: TUV / income share for me, a win scoring more the earlier it comes (turn out of horizon + 1). node.mean() = value / visits." style="shape=note;whiteSpace=wrap;html=1;fontSize=10;size=14;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="980" y="640" width="330" height="90" as="geometry"/></mxCell><mxCell id="iterate-c30" value="&lt;b&gt;Why decoded genomes&lt;/b&gt;&lt;br&gt;make_node stores evaluate's decoded genome (repaired, with segments appearing or vanishing as the game changes), so mutations always index the node's own segments." style="shape=note;whiteSpace=wrap;html=1;fontSize=10;size=14;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="980" y="750" width="330" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="evaluate" name="3 Activity — evaluate(genes): decode and score"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="evaluate-c1" value="TBETS.evaluate(genes) — decode the genome on the forward model and score it" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="30" as="geometry"/></mxCell><mxCell id="evaluate-c2" value="Activity diagram. Stored segments are looked up by their marker (turn, phase); a missing one is decoded from nothing. Other players are played greedily and never read genes." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1400" height="40" as="geometry"/></mxCell><mxCell id="evaluate-c3" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="405" y="100" width="30" height="30" as="geometry"/></mxCell><mxCell id="evaluate-c4" value="key(genes)&lt;br&gt;cached?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="320" y="150" width="200" height="90" as="geometry"/></mxCell><mxCell id="evaluate-c5" value="&lt;b&gt;return cached (value, decoded, turns)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1100" y="175" width="260" height="40" as="geometry"/></mxCell><mxCell id="evaluate-c6" value="" style="ellipse;html=1;shape=doubleEllipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1215" y="250" width="30" height="30" as="geometry"/></mxCell><mxCell id="evaluate-c7" value="stored ← {(seg.turn, seg.phase): seg.genes}&lt;br&gt;s ← state.clone(); turn_no ← 0; decoded, turns ← []" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="240" y="280" width="360" height="50" as="geometry"/></mxCell><mxCell id="evaluate-c8" value="" style="rhombus;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="405" y="350" width="30" height="30" as="geometry"/></mxCell><mxCell id="evaluate-c9" value="game over, step limit&lt;br&gt;or a rejected action?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="310" y="400" width="220" height="90" as="geometry"/></mxCell><mxCell id="evaluate-c10" value="phase_of(s) is purchase,&lt;br&gt;combat or noncombat?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="310" y="530" width="220" height="90" as="geometry"/></mxCell><mxCell id="evaluate-c11" value="&lt;b&gt;_between_segments(s)&lt;/b&gt;&lt;br&gt;placement at the home factory; battles: fast_battle's likely outcome, default casualties, no retreat; else EndPhase" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="680" y="540" width="360" height="70" as="geometry"/></mxCell><mxCell id="evaluate-c12" value="new acting&lt;br&gt;player?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="320" y="660" width="200" height="90" as="geometry"/></mxCell><mxCell id="evaluate-c13" value="turn_no += 1 (unless the first)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="720" y="685" width="280" height="40" as="geometry"/></mxCell><mxCell id="evaluate-c14" value="turn_no &amp;gt;&lt;br&gt;EMCTS_HORIZON?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="760" y="760" width="200" height="90" as="geometry"/></mxCell><mxCell id="evaluate-c15" value="other player: decoded += Segment(other, turn_no, player)&lt;br&gt;turns += Turn(player)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="680" y="890" width="360" height="50" as="geometry"/></mxCell><mxCell id="evaluate-c16" value="" style="rhombus;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="405" y="900" width="30" height="30" as="geometry"/></mxCell><mxCell id="evaluate-c17" value="acting player&lt;br&gt;is me?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="320" y="960" width="200" height="90" as="geometry"/></mxCell><mxCell id="evaluate-c18" value="&lt;b&gt;play_greedy(s, phase, player)&lt;/b&gt;&lt;br&gt;TripleMind: first purchase_actions option / strongest attack set per target / noncombat_move" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="680" y="1090" width="360" height="60" as="geometry"/></mxCell><mxCell id="evaluate-c19" value="&lt;b&gt;mine ← stored.get((turn_no, phase), ())&lt;/b&gt;&lt;br&gt;• purchase → decode_purchase: buy stored units still affordable, then TripleMind's purchase&lt;br&gt;• combat → play_combat: turn(s) targets; stored attack kept if units reach and are free, else strongest set / skip&lt;br&gt;• noncombat → decode_noncombat: air landings; per offered territory the stored option or strongest; positioning&lt;br&gt;decoded += Segment(phase, turn_no, me, genes); turns += Turn" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="220" y="1090" width="400" height="140" as="geometry"/></mxCell><mxCell id="evaluate-c20" value="&lt;b&gt;apply EndPhaseAction&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="300" y="1270" width="240" height="40" as="geometry"/></mxCell><mxCell id="evaluate-c21" value="&lt;b&gt;value ← evaluate_state(s, me, depth, horizon + 1)&lt;/b&gt;&lt;br&gt;depth = last segment's turn&lt;br&gt;cache under key(genes) and key(decoded)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1065" y="410" width="330" height="70" as="geometry"/></mxCell><mxCell id="evaluate-c22" value="&lt;b&gt;return (value, decoded, turns)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1100" y="520" width="260" height="40" as="geometry"/></mxCell><mxCell id="evaluate-c23" value="" style="ellipse;html=1;shape=doubleEllipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1215" y="590" width="30" height="30" as="geometry"/></mxCell><mxCell id="evaluate-c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="evaluate-c3" target="evaluate-c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="evaluate-c25" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="evaluate-c4" target="evaluate-c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="evaluate-c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="evaluate-c5" target="evaluate-c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="evaluate-c27" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="evaluate-c4" target="evaluate-c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="evaluate-c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="evaluate-c7" target="evaluate-c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="evaluate-c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="evaluate-c8" target="evaluate-c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="evaluate-c30" value="yes" style="edgeStyle=orthogonalEdgeStyle;ro
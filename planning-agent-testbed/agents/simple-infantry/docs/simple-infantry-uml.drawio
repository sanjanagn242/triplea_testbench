ll><mxCell id="classes-c74" value="parse_map_rules(gameXml)" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="agent" target="xml"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="832" y="500"/><mxPoint x="1410" y="500"/><mxPoint x="1410" y="230"/></Array></mxGeometry></mxCell><mxCell id="classes-c75" value="reads command" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="engine" target="manifest"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="classes-c76" value="starts process" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="engine" target="launcher"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="classes-c77" value="exec" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="launcher" target="main"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="classes-c78" value="No forward model: the agent reads the map rules from gameXml with regular expressions and plays only on the JSON observation. It buys the cheapest infantry rule with all its PUs, moves every infantry stack one step along a BFS toward the nearest enemy capital / victory city (only if it has at least as many units as the defending infantry), fights all battles and places at an owned factory (a capital first). Uses the older purchaseCount / placeAt action shapes." style="shape=note;whiteSpace=wrap;html=1;
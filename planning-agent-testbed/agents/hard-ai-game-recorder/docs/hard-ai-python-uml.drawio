;" edge="1" parent="1" source="calc" target="battlesim"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1335" y="540"/><mxPoint x="1684" y="540"/></Array></mxGeometry></mxCell><mxCell id="classes-c168" value="default_casualty_order" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="battlepy" target="toolkit"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2475" y="640"/><mxPoint x="2496" y="640"/></Array></mxGeometry></mxCell><mxCell id="classes-c169" value="unit_routes" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="movespy" target="toolkit"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2730" y="1013"/><mxPoint x="2730" y="195"/></Array></mxGeometry></mxCell><mxCell id="classes-c170" value="reads command" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="engine" target="manifest"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="classes-c171" value="starts process" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="engine" target="launcher"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="classes-c172" value="exec agent.py" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="launcher" target="agent"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="classes-c173" value="Phase AIs (combat, noncombat, purchase) build a fresh ProData and TerritoryManager for the state they analyse and get every battle estimate from ai.calc (OddsCalculator → triplea_fm.battlesim). battle.py and moves.py drive the kernel on clones: battles of the turn simulation are fought with this AI's casualty/retreat policies, and every planned move or placement is replayed with apply_in_place before it is returned." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fontSize=10;fillColor=#fffbe6;strokeColor=#b3a14d;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="400" height="98.0" as="geometry"/></mxCell><mxCell id="classes-c174" value="Analysis data (ProData, ProTerritory, MyMoveOptions, BattleResult, PurchaseOption, ...) is on page 2. Hard AI counterparts: ProAi/AbstractProAi, ProCombatMoveAi, ProNonCombatMoveAi, ProPurchaseAi, ProTerritoryManager, ProOddsCalculator, ProRetreatAi, ProMoveUtils." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;fontSize=10;fillColor=#fffbe6;strokeColor=#b3a14d;" vertex="1" parent="1"><mxGeometry x="740" y="1720" width="520" height="56.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="data" name="2 Class diagram — analysis data"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2560" pageHeight="1560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="data-c1" value="Hard AI (Python) — class diagram: analysis data (hardai/data.py)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1600" height="30" as="geometry"/></mxCell><mxCell id="data-c2" value="Blue = agent classes · green = search / strategy · purple = data · yellow = modules and free functions · orange = triplea_fm forward model (only the members the agent uses) · grey = engine, manifest and launcher." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1900" height="34" as="geometry"/></mxCell><mxCell id="data-c3" value="◆ composition (owns)   ◇ aggregation (holds a reference)   → association   dashed → dependency (uses / creates)   ▷ generalization" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="78" width="1400" height="18" as="geometry"/></mxCell><mxCell id="prodata" value="ProData  (ProData + ProMatches / ProUtils helpers)" style="swimlane;fontStyle=1;align=center;startSize=26;html=1;whiteSpace=wrap;childLayout=stackLayout;horizontal=1;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="620" height="362" as="geometry"/></mxCell><mxCell id="data-c4" value="+ d: GameDefinition;  s: SimulationState;  player: int;  n: int" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" parent="prodata"><mxGeometry x="0" y="26" width="620" height="18" as="geometry"/></mxCell><mxCell id="data-c5" value="+ my_capital: int | None" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" parent="prodata"><mxGeometry x="0" y="44" width="620" height="18" as="geometry"/></mxCell><mxCell id="data-c6" value="+ my_unit_territorie
<mxfile host="app.diagrams.net" type="device"><diagram id="p-loop" name="1 Process &amp; protocol loop"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p-loop-c1" value="1 · Process &amp; protocol loop  (run-agent.sh → agent.py main)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="30" as="geometry"/></mxCell><mxCell id="p-loop-c2" value="Every box links to the page that details it (click the box, or use the page tabs). Colours: see legend." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1400" height="24" as="geometry"/></mxCell><mxCell id="l-s1" value="Testbench starts the agent&lt;br&gt;agent.json → command: bash run-agent.sh" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="410.0" y="80" width="300" height="60" as="geometry"/></mxCell><mxCell id="l-n2" value="run-agent.sh&lt;br&gt;PYTHONPATH += ../../forward-model/python&lt;br&gt;exec python3 -u agent.py" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="410.0" y="180" width="300" height="70" as="geometry"/></mxCell><mxCell id="l-n3" value="main(): agent = TripleMindAgent(&lt;br&gt; time_budget = TRIPLEA_MCTS_SECONDS (2.0)&lt;br&gt; iter_budget = TRIPLEA_MCTS_ITERS (100000, unused)&lt;br&gt; depth_budget = TRIPLEA_MCTS_ROLLOUT (2)&lt;br&gt; exploration_constant = TRIPLEA_MCTS_EXP_CONST (1.414)&lt;br&gt; seed = TRIPLEA_MCTS_SEED (0))" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380.0" y="290" width="360" height="135" as="geometry"/></mxCell><mxCell id="l-n4" value="read next line from stdin" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=15;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="430.0" y="450" width="260" height="50" as="geometry"/></mxCell><mxCell id="l-d5" value="stdin closed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="450.0" y="540" width="220" height="80" as="geometry"/></mxCell><mxCell id="l-e5" value="process exits" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="810.0" y="555" width="180" height="50" as="geometry"/></mxCell><mxCell id="l-d6" value="line empty&lt;br&gt;(after strip)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="450.0" y="660" width="220" height="80" as="geometry"/></mxCell><mxCell id="l-n7" value="request = json.loads(line)&lt;br&gt;handle_request(request)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="430.0" y="780" width="260" height="60" as="geometry"/></mxCell><mxCell id="l-d8" value="request['type']?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="440.0" y="880" width="240" height="90" as="geometry"/></mxCell><UserObject label="game_start(request)&lt;br&gt;→ page 2" link="data:page/id,p-start" id="l-b1"><mxCell style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.06;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="140.0" y="1020" width="240" height="60" as="geometry"/></mxCell></UserObject><UserObject label="get_move(request)&lt;br&gt;→ page 3" link="data:page/id,p-move" id="l-b2"><mxCell style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.06;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="440.0" y="1020" width="240" height="60" as="geometry"/></mxCell></UserObject><mxCell id="l-b3" value="response = {error: 'Unknown request type: …'}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="730.0" y="1020" width="260" height="60" as="geometry"/></mxCell><mxCell id="l-d9" value="exception raised in&lt;br&gt;handle_request?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="440.0" y="1130" width="240" height="90" as="geometry"/></mxCell><mxCell id="l-n10" value="traceback → stderr&lt;br&gt;agent.log('error: …')&lt;br&gt;response = {error: repr(e)}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="780.0" y="1140" width="240" height="70" as="geometry"/></mxCell><mxCell id="l-n11" value="stdout.write(json.dumps(response) + newline)&lt;br&gt;flush()" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=15;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="400.0" y="1270" width="320" height="60" as="geometry"/></mxCell><mxCell id="p-loop-c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="l-s1" target="l-n2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-loop-c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="l-n2" target="l-n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-loop-c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fo
endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c-l4" target="c-l5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="490"/></Array></mxGeometry></mxCell><mxCell id="p-combatgen-c15" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c-l4" target="c-l6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="140" y="490"/></Array></mxGeometry></mxCell><mxCell id="p-combatgen-c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c-l5" target="c-l7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="715"/></Array></mxGeometry></mxCell><mxCell id="p-combatgen-c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c-l6" target="c-l7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="140" y="715"/></Array></mxGeometry></mxCell><mxCell id="p-combatgen-c18" value="getNextAction(): returns actions[actionIndex] and advances; None once exhausted.&lt;br&gt;&lt;br&gt;apply_combat_move(moves): for each CombatAction, stop at end_phase; otherwise fm.apply_in_place every MoveAction (units move into the target; the battle is fought later in the battle phase).&lt;br&gt;&lt;br&gt;excluded: targets already decided this phase (attacked, skipped or unreachable). It only grows inside combat_actions; the node's clone carries it to the child." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="800" width="500" height="210" as="geometry"/></mxCell><mxCell id="p-combatgen-c19" value="action_generators.combat_actions(game, definition, excluded, player)  — port of heuristic_combat_legal_moves" style="rounded=1;arcSize=2;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="620" y="60" width="820" height="1740" as="geometry"/></mxCell><mxCell id="c-r0" value="combat_actions(game, definition, excluded, player)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760.0" y="110" width="380" height="50" as="geometry"/></mxCell><mxCell id="c-r1" value="excluded = copy(excluded); actions = []" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="800.0" y="200" width="300" height="40" as="geometry"/></mxCell><mxCell id="c-r2" value="targets = enemy_territories_by_priority(game, player)&lt;br&gt;(see note)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="770.0" y="280" width="360" height="60" as="geometry"/></mxCell><mxCell id="c-r3" value="next target t&lt;br&gt;(priority order)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="830.0" y="380" width="240" height="90" as="geometry"/></mxCell><mxCell id="c-rend" value="return (actions, excluded)&lt;br&gt;— actions = [] when none left" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1140.0" y="395" width="260" height="60" as="geometry"/></mxCell><mxCell id="c-r4" value="t ∈ excluded?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="850.0" y="510" width="200" height="80" as="geometry"/></mxCell><mxCell id="c-r5" value="reachable = get_reachable_units(game, t, player)&lt;br&gt;→ [(unit, from, route)]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="770.0" y="630" width="360" height="60" as="geometry"/></mxCell><mxCell id="c-r6" value="reachable empty?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="840.0" y="730" width="220" height="80" as="geometry"/></mxCell><mxCell id="c-r7" value="excluded.add(t)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1180.0" y="745" width="180" height="50" as="geometry"/></mxCell><mxCell id="c-r8" value="sort reachable by donor_score (desc):&lt;br&gt;+100 if 'from' is adjacent to t, +10 × attack" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="770.0" y="850" width="360" height="60" as="geometry"/></mxCell><mxCell id="c-r9" value="def_strength = defender_strength(t):&lt;br&gt;Σ defense of non-infrastructure units not owned by player" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="760.0" y="950" width="380" height="60" as="geometry"/></mxCell><mxCell id="c-r10" value="threshold = 1.5; sets = []&lt;br&gt;add units one by one (sorted order); after each:&lt;br&gt; if strength &gt; threshold × def and strength &lt; 3.5 × def + 4:&lt;br&gt;   record (units so far, strength); threshold += 0.1&lt;br&gt;(strength = calculate_attack_strength)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="750.0" y="1050" width="400" height="110" as="geometry"/></mxCell><mxCell id="c-r11" value="full-force strength &gt; def&lt;br&gt;and ≠ last set's strength?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="810.0" y="1200" width="280" height="100" as="geometry"/></mxCell><mxCell id="c-r12" value="append the full&lt;br&gt;force as a set" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1180.0" y="1220" width="180" height="60" as="geometry"/></mxCell><mxCell id="c-r13" value="no sets and def == 0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="830.0" y="1340" width="240" height="80" as="geometry"/></mxCell><mxCell id="c-r14" value="actions += capture with the&lt;br&gt;cheapest single unit&lt;br&gt;(strength = its attack)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1160.0" y="1345" width="220" height="70" as="geometry"/></mxCell><mxCell id="c-r15" value="for each set, strongest first:&lt;br&gt;actions += CombatAction(t, _group_moves(units),&lt;br&gt;strength)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="760.0" y="1460" width="380" height="70" as="geometry"/></mxCell><mxCell id="c-r16" value="actions += skip: CombatAction(t, moves=[], strength=0)&lt;br&gt;excluded.add(t)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="760.0" y="1570" width="380" height="60" as="geometry"/></mxCell><mxCell id="c-r17" value="return (actions, excluded)&lt;br&gt;— one target per call" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800.0" y="1680" width="300" height="60" as="geometry"/></mxCell><mxCell id="p-combatgen-c39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c-r0" target="c-r1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-combatgen-c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c-r1" target="c-r2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-combatgen-c41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c-r2" target="c-r3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-combatgen-c42" value="none left" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c-r3" target="c-rend"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-combatgen-c43" value="t" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c-r3" target="c-r4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-combatgen-c44" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c-r4" target="c-r3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="660" y="550"/><mxPoint x="660" y="425"/></Array></mxGeometry></mxCell><mxCell id="p-combatgen-c45" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c-r4" target="c-r5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-combatgen-c46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c-r5" target="c-r6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-combatgen-c47" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c-r6" target="c-r7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-combatgen-c48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c-r7" target="c-r3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1410" y="770"/><mxPoint x="1410" y="360"/><mxPoint x="950" y="360"/></Array></mxGeometry></mxCell><mxCell id="p-combatgen-c49" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c-r6" target="c-r8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-combatgen-c50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c-r8" target="c-r9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-combatgen-c51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c-r9" target="c-r10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-combatgen-c52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c-r10" target="c-r11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-combatgen-c53" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c-r11" target="c-r12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-combatgen-c54" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c-r11" target="c-r13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-combatgen-c55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c-r12" target="c-r13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1270" y="1320"/><mxPoint x="950" y="1320"/></Array></mxGeometry></mxCell><mxCell id="p-combatgen-c56" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c-r13" target="c-r14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-combatgen-c57" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c-r13" target="c-r15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-combatgen-c58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c-r14" target="c-r15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1270" y="1495"/></Array></mxGeometry></mxCell><mxCell id="p-combatgen-c59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c-r15" target="c-r16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-combatgen-c60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c-r16" target="c-r17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-combatgen-c61" value="enemy_territories_by_priority(game, player)&lt;br&gt;• candidate = land territory not owned by player that borders one of mine&lt;br&gt;• score: +1000 victory city · +500 per adjacent victory city · +100 × production · +50 per bordering territory of mine · −30 per neighbour with the same owner as the candidate&lt;br&gt;• sorted high → low" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1480" y="90" width="420" height="150" as="geometry"/></mxCell><mxCell id="p-combatgen-c62" value="get_reachable_units(game, t, player)&lt;br&gt;• units: mine, in territories I own, not static (factory / AA / infrastructure), not moved this turn, not sea&lt;br&gt;• _reach_routes(start, unit range, domain): BFS that may pass only through territories I own; the destination may be anything; keeps one route per destination" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1480" y="270" width="420" height="150" as="geometry"/></mxCell><mxCell id="p-combatgen-c63" value="calculate_attack_strength(units)&lt;br&gt;Σ attack; each artillery-supportable unit paired 1:1 with an artillery gets +1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1480" y="450" width="420" height="70" as="geometry"/></mxCell><mxCell id="p-combatgen-c64" value="_group_moves(definition, [(unit, route)])&lt;br&gt;one fm.MoveAction per distinct route: (unit fm ids, territory indices)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1480" y="550" width="420" height="70" as="geometry"/></mxCell><mxCell id="p-combatgen-c65" value="Differences from move_generator.pyx (translation):&lt;br&gt;• no 1 ms time_budget cut-offs&lt;br&gt;• targets iterated in priority order (the .pyx iterated a set)&lt;br&gt;• strength counted per unit (the .pyx overcounted infantry)&lt;br&gt;• water territories are never targets&lt;br&gt;• moves are not pre-validated; the forward model may reject one when applied" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1480" y="650" width="420" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p-purchase" name="7 purchase_actions"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1350" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p-purchase-c1" value="7 · action_generators.purchase_actions(game, definition, player=None)  — live purchase phase" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="30" as="geometry"/></mxCell><mxCell id="u-s" value="purchase_actions(game, definition, player)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="270.0" y="80" width="340" height="50" as="geometry"/></mxCell><mxCell id="u-n1" value="player = player or game.whoAmI&lt;br&gt;resources = game.players[player].PU" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="290.0" y="170" width="300" height="60" as="geometry"/></mxCell><mxCell id="u-d2" value="player owns a unit with can_produce&lt;br&gt;(isFactory / canProduceUnits)&lt;br&gt;in a territory it owns?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="250.0" y="265" width="380" height="125" as="geometry"/></mxCell><mxCell id="u-e1" value="return []" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740.0" y="300" width="160" height="50" as="geometry"/></mxCell><mxCell id="u-n3" value="rules = rules in the player's frontier (map.purchasable) that build a land unit,&lt;br&gt;not infrastructure, not AA, costing only PUs (&gt; 0)  → (rule name, cost, unit type)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1"><mxGeometry x="230.0" y="420" width="420" height="70" as="geometry"/></mxCell><mxCell id="u-d4" value="first PURCHASE_BIAS entry&lt;br&gt;with round &lt; limit?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="300.0" y="530" width="280" height="90" as="geometry"/></mxCell><mxCell id="u-n5" value="rules += rules whose roles match:&lt;br&gt;5 → infantry · 10 → infantry, blitz · 15 → blitz, artillery&lt;br&gt;(roles: isInfantry → infantry, canBlitz → blitz, artillery → artillery)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="710.0" y="535" width="420" height="80" as="geometry"/></mxCell><mxCell id="u-n6" value="sort rules by cost (ascending)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="310.0" y="660" width="260" height="40" as="geometry"/></mxCell><mxCell id="u-n7" value="purchase_dict = {}; remaining = resources; i = 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="270.0" y="740" width="340" height="40" as="geometry"/></mxCell><mxCell id="u-d8" value="affordable = rules with cost ≤ remaining&lt;br&gt;— empty?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="280.0" y="820" width="320" height="90" as="geometry"/></mxCell><mxCell id="u-n9" value="name, cost = affordable[i mod len(affordable)]&lt;br&gt;purchase_dict[name] += 1&lt;br&gt;remaining −= cost; i += 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="740.0" y="830" width="320" height="70" as="geometry"/></mxCell><mxCell id="u-d10" value="purchase_dict empty?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="320.0" y="960" width="240" height="80" as="geometry"/></mxCell><mxCell id="u-e2" value="return []" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740.0" y="975" width="160" height="50" as="geometry"/></mxCell><mxCell id="u-e3" value="return [PurchaseAction(((rule_id, count), …))]&lt;br&gt;rule_id = definition.production_rule_index[name]" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250.0" y="1090" width="380" height="60" as="geometry"/></mxCell><mxCell id="p-purchase-c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="u-s" target="u-n1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-purchase-c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="u-n1" target="u-d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-purchase-c18" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="u-d2" target="u-e1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-purchase-c19" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="u-d2" target="u-n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-purchase-c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="u-n3" target="u-d4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-purchase-c21" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="u-d4" target="u-n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-purchase-c22" value="no (round ≥ 15)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="u-d4" target="u-n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-purchase-c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="u-n5" target="u-n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="680"/></Array></mxGeometry></mxCell><mxCell id="p-purchase-c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="u-n6" target="u-n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-purchase-c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="u-n7" target="u-d8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-purchase-c26" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="u-d8" target="u-n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-purchase-c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="u-n9" target="u-d8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="930"/><mxPoint x="1120" y="930"/><mxPoint x="1120" y="800"/><mxPoint x="440" y="800"/></Array></mxGeometry></mxCell><mxCell id="p-purchase-c28" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="u-d8" target="u-d10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-purchase-c29" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="u-d10" target="u-e2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-purchase-c30" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="u-d10" target="u-e3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-purchase-c31" value="Spends every PU; placement capacity is not checked (units that cannot be placed are lost at the end of the place step)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="900" y="1080" width="360" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p-noncombat" name="8 noncombat_move (live)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p-noncombat-c1" value="8 · action_generators.noncombat_move(game, definition, player, objectives)  — live non-combat phase" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="30" as="geometry"/></mxCell><mxCell id="n-s" value="noncombat_move(game, definition, player, objectives)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280.0" y="80" width="400" height="50" as="geometry"/></mxCell><mxCell id="n-n1" value="objectives = map.objectives() (highest-production territories) unless given&lt;br&gt;victory_cities, capitals from the map" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1"><mxGeometry x="260.0" y="170" width="440" height="60" as="geometry"/></mxCell><mxCell id="n-n2" value="strength[t] = # non-infrastructure units (any owner) per territory&lt;br&gt;movable[t] = my land/air units with movement_left &gt; 0, per owned territory" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="250.0" y="265" width="460" height="75" as="geometry"/></mxCell><mxCell id="n-n3" value="my_frontier = my territories with a land neighbour I don't own&lt;br&gt;home_factory = _home_factory(game, player)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1"><mxGeometry x="260.0" y="370" width="440" height="60" as="geometry"/></mxCell><mxCell id="n-n4" value="staging_score = # frontier neighbours; factory_adj_score = # adjacent victory cities&lt;br&gt;dist_to_frontier, dist_to_objective = multi-source BFS over the land graph" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1"><mxGeometry x="250.0" y="465" width="460" height="75" as="geometry"/></mxCell><mxCell id="n-n5" value="targets = my territories by priority: frontier +1000 (+500 if empty) · +200 × staging&lt;br&gt;· +100 × victory-city ring · +20 × max(0, 5 − dist to objective)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="260.0" y="570" width="440" height="60" as="geometry"/></mxCell><mxCell id="n-n6" value="quota(t): home 8% of my units · frontier max(3, min(threat + 2, 15%)) · staging / VC ring 3% · objective 2% · else 1% (min 1)&lt;br&gt;frontier_excess(t) = strength − (max enemy neighbour + 2), ≥ 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="260.0" y="670" width="440" height="80" as="geometry"/></mxCell><mxCell id="p-noncombat-c9" value="PASS 0 — evacuate the home factory" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="230" y="780" width="300" height="24" as="geometry"/></mxCell><mxCell id="n-d7" value="home factory has&lt;br&gt;movable units?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="360.0" y="810" width="240" height="90" as="geometry"/></mxCell><mxCell id="n-n8" value="keep_min = 2 if a non-capital enemy neighbour, else 0&lt;br&gt;excess = strength[home] − keep_min" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="280.0" y="940" width="400" height="60" as="geometry"/></mxCell><mxCell id="n-n9" value="for each movable unit at home while excess &gt; 0:&lt;br&gt; dest, score = best_step_toward_frontier(unit, home)&lt;br&gt; if score &gt; 0: send(unit, home, dest); excess −= 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="270.0" y="1040" width="420" height="80" as="geometry"/></mxCell><mxCell id="p-noncombat-c13" value="PASS 1 — fill targets to quota" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="230" y="1140" width="300" height="24" as="geometry"/></mxCell><mxCell id="n-n10" value="for target in targets (priority order):&lt;br&gt; for donor in my territories (≠ target):&lt;br&gt;  while strength[target] &lt; quota(target) and can_donate(donor):&lt;br&gt;   first unit that can_reach(target) → send to target&lt;br&gt;   else first unit with best_step score &gt; 0 → send there&lt;br&gt;   none → next donor" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="260.0" y="1170" width="440" height="120" as="geometry"/></mxCell><mxCell id="n-n11" value="for each (src, dst) and unit domain:&lt;br&gt;route = map.path(src, dst, domain, avoid = not-mine for land)&lt;br&gt;→ fm.MoveAction(unit fm ids, territory indices)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1"><mxGeometry x="260.0" y="1330" width="440" height="70" as="geometry"/></mxCell><mxCell id="n-e" value="return [MoveAction]" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="370.0" y="1440" width="220" height="50" as="geometry"/></mxCell><mxCell id="p-noncombat-c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n-s" target="n-n1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-noncombat-c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n-n1" target="n-n2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-noncombat-c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n-n2" target="n-n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-noncombat-c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n-n3" target="n-n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-noncombat-c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n-n4" target="n-n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-noncombat-c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n-n5" target="n-n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-noncombat-c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n-n6" target="n-d7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-noncombat-c24" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n-d7" target="n-n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-noncombat-c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n-n8" target="n-n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-noncombat-c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n-n9" target="n-n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-noncombat-c27" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-d7" target="n-n10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="200" y="855"/><mxPoint x="200" y="1230"/></Array></mxGeometry></mxCell><mxCell id="p-noncombat-c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n-n10" target="n-n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-noncombat-c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="n-n11" target="n-e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-noncombat-c30" value="reach / can_reach(unit, src, dst)&lt;br&gt;map.reachable(src, movement_left, domain, avoid); land avoids territories I don't own, air avoids nothing; the destination must be mine" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="760" y="810" width="380" height="80" as="geometry"/></mxCell><mxCell id="p-noncombat-c31" value="best_step_toward_frontier(unit, from)&lt;br&gt;reachable owned destination maximising&lt;br&gt;100 × (dist_to_frontier improvement) + 50 if frontier + 10 × staging + 5 × VC ring" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="760" y="910" width="380" height="80" as="geometry"/></mxCell><mxCell id="p-noncombat-c32" value="send(unit, src, dst): unit leaves movable; strength[src] −1, strength[dst] +1; frontier excess of src −1&lt;br&gt;&lt;br&gt;can_donate(t): has movable units; frontier tiles (except home) only while frontier_excess &gt; 0" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="760" y="1010" width="380" height="100" as="geometry"/></mxCell><mxCell id="p-noncombat-c33" value="Differences from generate_legal_noncombat_moves:&lt;br&gt;• arriving units count toward the target's quota (the original never incremented it)&lt;br&gt;• FACTORY_MAP → capital / own factory; 'Flag' → objectives&lt;br&gt;• sea units are never moved" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="760" y="1130" width="380" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p-ncrollout" name="9 noncombat_move_rollout"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p-ncrollout-c1" value="9 · action_generators.noncombat_move_rollout(game, definition, player)  — rollout non-combat (port of the .pyx)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="30" as="geometry"/></mxCell><mxCell id="o-s" value="noncombat_move_rollout(game, definition, player)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290.0" y="80" width="380" height="50" as="geometry"/></mxCell><mxCell id="o-n1" value="qty_snap[t][(type, owner)] = unit counts (the only thing mutated)&lt;br&gt;free_units[t] = my real units per owned territory (each moves at most once)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="260.0" y="170" width="440" height="60" as="geometry"/></mxCell><mxCell id="o-n2" value="frontier = my territories with any neighbour I don't own&lt;br&gt;home_factory = _home_factory; capitals; victory cities" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1"><mxGeometry x="260.0" y="270" width="440" height="60" as="geometry"/></mxCell><mxCell id="o-n3" value="staging_score = # frontier neighbours&lt;br&gt;factory_adj_score: +3 if neighbour is the home factory, +1 per adjacent victory city&lt;br&gt;dist_to_frontier = multi-source BFS over the full graph" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1"><mxGeometry x="260.0" y="370" width="440" height="70" as="geometry"/></mxCell><mxCell id="o-n4" value="total_my_units = Σ snapshot counts in my territories&lt;br&gt;frontier_excess(t) = count − (max enemy neighbour count + 2), ≥ 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="260.0" y="480" width="440" height="60" as="geometry"/></mxCell><mxCell id="o-n5" value="targets = my territories by priority: frontier +1000 (+500 if empty) · +200 × staging · +100 × factory_adj" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="260.0" y="580" width="440" height="50" as="geometry"/></mxCell><mxCell id="o-n6" value="quota(t): home max(1, 8%) · frontier max(3, min(threat + 2, 15%)) · staging / factory-adj max(1, 3%) · else max(1, 1%)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="260.0" y="670" width="440" height="50" as="geometry"/></mxCell><mxCell id="o-n7" value="donors = my territories with units (frontier tiles except home need excess &gt; 0)&lt;br&gt;sorted by (count − quota), descending" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="260.0" y="760" width="440" height="60" as="geometry"/></mxCell><mxCell id="p-ncrollout-c10" value="PASS 0 — evacuate the home factory" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="230" y="840" width="300" height="24" as="geometry"/></mxCell><mxCell id="o-d8" value="home factory has&lt;br&gt;my units?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="360.0" y="870" width="240" height="90" as="geometry"/></mxCell><mxCell id="o-n9" value="keep_min = 2 if a non-capital enemy neighbour, else 0; excess = count(home) − keep_min&lt;br&gt;for each mobile unit at home while sent &lt; excess: best step (score &gt; 0) → move&lt;br&gt;snapshot of home −1 (destination NOT credited)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="260.0" y="1000" width="440" height="80" as="geometry"/></mxCell><mxCell id="p-ncrollout-c13" value="PASS 1 — fill targets to quota" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="230" y="1100" width="300" height="24" as="geometry"/></mxCell><mxCell id="o-n10" value="for target in targets, while count(target) &lt; quota(target):&lt;br&gt; donor = donors[idx]&lt;br&gt; drain guard: frontier donor needs count &gt; its excess; other donors keep 2 (enemy neighbour) or 1&lt;br&gt; pick the first free unit whose snapshot qty &gt; 0&lt;br&gt; reach the target directly, else best step (score &gt; 0); none → next donor&lt;br&gt; move: donor −1, destination +1 (credited), donor frontier excess −1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="250.0" y="1125" width="460" height="150" as="geometry"/></mxCell><mxCell id="o-n11" value="_group_moves: one fm.MoveAction per (from, route)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="290.0" y="1300" width="380" height="50" as="geometry"/></mxCell><mxCell id="o-e" value="return [MoveAction]" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="370.0" y="1390" width="220" height="50" as="geometry"/></mxCell><mxCell id="p-ncrollout-c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="o-s" target="o-n1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-ncrollout-c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="o-n1" target="o-n2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-ncrollout-c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="o-n2" target="o-n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-ncrollout-c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="o-n3" target="o-n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-ncrollout-c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="o-n4" target="o-n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-ncrollout-c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="o-n5" target="o-n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-ncrollout-c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="o-n6" target="o-n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-ncrollout-c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="o-n7" target="o-d8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-ncrollout-c25" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="o-d8" target="o-n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-ncrollout-c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="o-n9" target="o-n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-ncrollout-c27" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="o-d8" target="o-n10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="200" y="915"/><mxPoint x="200" y="1195"/></Array></mxGeometry></mxCell><mxCell id="p-ncrollout-c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="o-n10" target="o-n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-ncrollout-c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="o-n11" target="o-e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-ncrollout-c30" value="reach(unit, from) = _reach_routes(from, full unit range, domain): passes only through my territories. The range ignores movement already used (as in the .pyx), so the model may reject some moves; rejected moves are skipped." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="760" y="870" width="380" height="100" as="geometry"/></mxCell><mxCell id="p-ncrollout-c31" value="best_step_toward_frontier: owned destination reachable from 'from' maximising 100 × improvement + 50 if frontier + 10 × staging + 5 × factory_adj" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="760" y="1000" width="380" height="70" as="geometry"/></mxCell><mxCell id="p-ncrollout-c32" value="Used only inside rollouts (_rollout_noncombat). The live phase uses noncombat_move (page 8)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="760" y="1090" width="380" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p-eval" name="10 evaluate_state"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p-eval-c1" value="10 · mcts.evaluate_state(state, whoAmI, victory_cities, depth, depth_budget)  — rollout reward" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="30" as="geometry"/></mxCell><mxCell id="v-s" value="evaluate_state(state, whoAmI, victory_cities, depth, depth_budget)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220.0" y="80" width="440" height="50" as="geometry"/></mxCell><mxCell id="v-n1" value="game = state.view()  (GameState.from_sim)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1"><mxGeometry x="280.0" y="170" width="320" height="40" as="geometry"/></mxCell><mxCell id="v-d2" value="one owner holds every&lt;br&gt;victory city?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="310.0" y="250" width="260" height="90" as="geometry"/></mxCell><mxCell id="v-d3" value="owner == me?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="760.0" y="255" width="200" height="80" as="geometry"/></mxCell><mxCell id="v-e1" value="return (0.5 + 0.5·(budget − depth)/budget, True)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1030.0" y="265" width="300" height="60" as="geometry"/></mxCell><mxCell id="v-e2" value="return (−0.5 − 0.5·(budget − depth)/budget, True)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700.0" y="380" width="320" height="60" as="geometry"/></mxCell><mxCell id="v-n4" value="my_tuv / enemy_tuv = Σ map.unit_cost(type) of non-infrastructure units&lt;br&gt;(mine vs other non-Neutral owners)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="230.0" y="390" width="420" height="60" as="geometry"/></mxCell><mxCell id="v-n5" value="tuv_term = my_tuv / max(my_tuv + enemy_tuv, 1e-9)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="250.0" y="490" width="380" height="40" as="geometry"/></mxCell><mxCell id="v-n6" value="income_term = my PUs / Σ all players' PUs  (0 if Σ = 0)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="250.0" y="570" width="380" height="40" as="geometry"/></mxCell><mxCell id="v-e3" value="return (0.5 × (0.5·tuv_term + 0.5·income_term), False)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240.0" y="650" width="400" height="50" as="geometry"/></mxCell><mxCell id="p-eval-c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="v-s" target="v-n1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-eval-c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="v-n1" target="v-d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-eval-c14" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="v-d2" target="v-d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-eval-c15" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="v-d3" target="v-e1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-eval-c16" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="v-d3" target="v-e2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-eval-c17" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="v-d2" target="v-n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-eval-c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="v-n4" target="v-n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-eval-c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="v-n5" target="v-n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-eval-c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="v-n6" target="v-e3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p-eval-c21" value="Reward range: non-terminal 0 … 0.5; terminal ±(0.5 … 1.0), larger the earlier it happens. simulate() returns −0.5 on an exception.&lt;br&gt;&lt;br&gt;Dropped from the .pyx because they were computed but not used in the score: vc_term, flag ownership, proximity to the flag." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="860" y="480" width="400" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>

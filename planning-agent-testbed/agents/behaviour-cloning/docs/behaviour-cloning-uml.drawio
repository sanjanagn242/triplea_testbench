00" as="geometry"/></mxCell><mxCell id="bc-dp-activity-c11" value="A1 observationPlayer = activePlayer = actor · A3 graph on observation and every path snapshot&lt;br&gt;A4 root snapshot units = observation units" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="520" y="620" width="380" height="50" as="geometry"/></mxCell><mxCell id="bc-dp-activity-c12" value="loop [each path node k]" style="shape=umlFrame;whiteSpace=wrap;html=1;width=150;height=24;fontSize=11;fillColor=none;dashed=0;" vertex="1" parent="1"><mxGeometry x="500" y="690" width="860" height="1060" as="geometry"/></mxCell><mxCell id="bc-dp-activity-c13" value="sim = bridge.build_state(snapshot k)&lt;br&gt;conquered / blitzed ← replay of earlier expert actions&lt;br&gt;(the snapshot does not record blitzes)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="520" y="730" width="380" height="60" as="geometry"/></mxCell><mxCell id="bc-dp-activity-c14" value="view = GameState.from_sim · ag.combat_actions(view, excluded)&lt;br&gt;(none → [end_phase]) → generated_candidates (canonical, deduplicated)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="520" y="810" width="380" height="50" as="geometry"/></mxCell><mxCell id="bc-dp-activity-c15" value="MCTS chose&lt;br&gt;a child?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="620" y="880" width="180" height="80" as="geometry"/></mxCell><mxCell id="bc-dp-activity-c16" value="leaf: terminal_reason vs generator&lt;br&gt;(no_target ⇔ only end_phase; timeout ⇔ target)  A9" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="960" y="895" width="300" height="50" as="geometry"/></mxCell><mxCell id="bc-dp-activity-c17" value="expert = chosen child (recorded_candidate)&lt;br&gt;A4 snapshot = previous chosen child's state; expert target = generator target&lt;br&gt;A9 attacks then exactly one skip, no end-phase&lt;br&gt;A7 units: committed ones moved, others unchanged, expert/candidate units available&lt;br&gt;A5 expert key ∈ candidate keys (strength equal)&lt;br&gt;A6 every candidate accepted by apply_in_place&lt;br&gt;A8 apply expert → engine_observation = snapshot k+1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="520" y="990" width="380" height="150" as="geometry"/></mxCell><mxCell id="bc-dp-activity-c18" value="all passed?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="620" y="1160" width="180" height="80" as="geometry"/></mxCell><mxCell id="bc-dp-activity-c19" value="failed_samples += {record, step, level, reasons}" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="960" y="1175" width="300" height="50" as="geometry"/></mxCell><mxCell id="bc-dp-activity-c20" value="_sample: node_features (29×45), global_features (3),&lt;br&gt;candidate_features (C×94), expert_index, z, metadata&lt;br&gt;(unit ids, routes, committed, mcts_visits — not features)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="520" y="1270" width="380" height="60" as="geometry"/></mxCell><mxCell id="bc-dp-activity-c21" value="excluded ← generator's excluded · committed += expert units&lt;br&gt;history ← conquered / blitzed after the expert" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="520" y="
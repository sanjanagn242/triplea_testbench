<mxfile host="app.diagrams.net" type="device"><diagram id="bc-overview" name="1 Overview — end-to-end pipeline"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bc-overview-c0" value="Behaviour cloning of TripleMind attack formations — end-to-end" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1600" height="30" as="geometry"/></mxCell><mxCell id="bc-overview-c1" value="Artefacts (grey) flow left to right; each box is a stage with its entry point." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1400" height="20" as="geometry"/></mxCell><mxCell id="bc-overview-c2" value="&lt;b&gt;TripleMind MCTS agent&lt;/b&gt;&lt;br&gt;agents/tripleMind/agent.py&lt;br&gt;TRIPLEMIND_RECORD=1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="230" height="90" as="geometry"/></mxCell><mxCell id="bc-overview-c3" value="&lt;b&gt;records/*.jsonl&lt;/b&gt;&lt;br&gt;header · combatMove steps with tree path · result" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="320" y="150" width="200" height="70" as="geometry"/></mxCell><mxCell id="bc-overview-c4" value="&lt;b&gt;Data processing&lt;/b&gt;&lt;br&gt;prepare_dataset.process_records()&lt;br&gt;attack_formation_dataset.py&lt;br&gt;AttackFormationDataset.from_records · split_by_game · save&lt;br&gt;assertions A1–A10" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="570" y="120" width="260" height="130" as="geometry"/></mxCell><mxCell id="bc-overview-c5" value="&lt;b&gt;data/&lt;/b&gt;&lt;br&gt;dataset.pkl · splits.json&lt;br&gt;feature_names.json · report.json/.txt" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="140" width="230" height="90" as="geometry"/></mxCell><mxCell id="bc-overview-c6" value="&lt;b&gt;Training&lt;/b&gt;&lt;br&gt;run_bc.py train&lt;br&gt;bc_baseline: data · model · train&lt;br&gt;Adam, cross-entropy over candidates,&lt;br&gt;early stopping on val loss" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1160" y="120" width="250" height="130" as="geometry"/></mxCell><mxCell id="bc-overview-c7" value="&lt;b&gt;runs/&amp;lt;name&amp;gt;/&lt;/b&gt;&lt;br&gt;best.pt · config.json · history.json&lt;br&gt;training_curves.png" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1460" y="140" width="230" height="90" as="geometry"/></mxCell><mxCell id="bc-overview-c8" value="&lt;b&gt;Evaluation&lt;/b&gt;&lt;br&gt;run_bc.py evaluate / sanity&lt;br&gt;bc_baseline.evaluate&lt;br&gt;metrics + random / always-skip / first-candidate baselines" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1160" y="330" width="250" height="110" as="geometry"/></mxCell><mxCell id="bc-overview-c9" value="&lt;b&gt;eval.json&lt;/b&gt;&lt;br&gt;per split: loss, acc, skip P/R/F1, by size" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1460" y="350" width="230" height="70" as="geometry"/></mxCell><mxCell id="bc-overview-c10" value="&lt;b&gt;Running: tripleMind-bc agent&lt;/b&gt;&lt;br&gt;agents/tripleMind_hybrids/tripleMind-bc&lt;br&gt;TripleMindBC(SearchAgent) + BCPolicy" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1460" y="520" width="230" height="110" as="geometry"/></mxCell><mxCell id="bc-overview-c11" value="&lt;b&gt;TripleA engine / tools/arena.py&lt;/b&gt;&lt;br&gt;testbench protocol (JSON lines)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=20;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1110" y="540" width="250" height="70" as="geometry"/></mxCell><mxCell id="bc-overview-e12" value="writes" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="bc-overview-c2" target="bc-overview-c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="bc-overview-e13" value="reads" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="bc-overview-c3" target="bc-overview-c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="bc-overview-e14" value="saves" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="bc-overview-c4" target="bc-overview-c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="bc-overview-e15" value="load mode" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="bc-overview-c5" target="bc-overview-c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="bc-overview-e16" value="" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="bc-overview-c3" target="bc-overview-c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="bc-overview-e17" value="saves" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="bc-overview-c6" target="bc-overview-c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="bc-overview-e18" value="best.pt" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="bc-overview-c7" target="bc-overview-c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="bc-overview-e19" value="" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="bc-overview-c5" target="bc-overview-c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="bc-overview-e20" value="writes" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="bc-overview-c8" target="bc-overview-c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="bc-overview-e21" value="TRIPLEMIND_BC_CHECKPOINT" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="bc-overview-c7" target="bc-overview-c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="bc-overview-e22" value="plays" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="bc-overview-c10" target="bc-overview-c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="bc-overview-e23" value="plays" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="bc-overview-c11" target="bc-overview-c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="bc-overview-c24" value="&lt;b&gt;Two data modes&lt;/b&gt; (bc_baseline/data.py)&lt;br&gt;• process mode: run_bc.py train --records … → process_records() → save → make_inputs()&lt;br&gt;• load mode: run_bc.py train --data-dir data → AttackFormationDataset.load() + splits.json → make_inputs()&lt;br&gt;Both end in make_inputs(); the SHA-256 input fingerprint proves they are identical (check 7)." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=10;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="570" y="300" width="420" height="120" as="geometry"/></mxCell><mxCell id="bc-overview-c25" value="&lt;b&gt;One sample = one MCTS sub-action&lt;/b&gt;&lt;br&gt;a node on the recorded tree path where MCTS chose a child: the target is fixed by TripleMind's heuristic, the candidates are the generator's formations for it (attack sets + skip), the label is the chosen one. z = 1 if the recording faction won." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=10;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="480" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="bc-dp-classes" name="2 Data processing — class diagram"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bc-dp-classes-c0" value="Data processing — class diagram (behaviour-cloning/data-processing/attack_formation_dataset.py, prepare_dataset.py)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1600" height="30" as="geometry"/></mxCell><mxCell id="bc-dp-classes-c1" value="Blue = agent classes · green = pipeline / model classes · purple = data containers · yellow = modules and free functions · orange = triplea_fm forward model / PyTorch · grey = TripleMind, engine, CLI, files." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1600" height="20" as="geometry"/></mxCell><mxCell id="bc-dp-classes-c2" value="◆ composition (owns)   ◇ aggregation (holds a reference)   ▷ generalization   dashed → dependency (uses / creates)" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1600" height="20" as="geometry"/></mxCell><mxCell id="bc-dp-classes-c3" value="&lt;b&gt;AttackFormationDataset&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;startSize=42;html=1;whiteSpace=wrap;childLayout=stackLayout;horizontal=1;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="700" y="100" width="430" height="322" as="geometry"/></mxCell><mxCell id="bc-dp-classes-c4" value="+ samples: List[Sample]" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=0;fontSize=11;" vertex="1" parent="bc-dp-classes-c3"><mxGeometry x="0" y="42" width="430" height="20" as="geometry"/></mxCell><mxCell id="bc-dp-classes-c5" value="+ graph: StaticGraph" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=0;fontSize=11;" vertex="1" parent="bc-dp-classes-c3"><mxGeometry x="0" y="62" width="430" height="20" as="geometry"/></mxCell><mxCell id="bc-dp-classes-c6" value="+ spec: FeatureSpec" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=0;fontSize=11;" vertex="1" parent="bc-dp-classes-c3"><mxGeometry x="0" y="82" width="430" height="20" as="geometry"/></mxCell><mxCell id="bc-dp-classes-c7" value="+ report: ValidationReport" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=0;fontSize=11;" vertex="1" parent="bc-dp-classes-c3"><mxGeometry x="0" y="102" width="430" height="20" as="geometry"/></mxCell><mxCell id="bc-dp-classes-c8" value="+ config: dict  (records, game_xml, digest, fingerprint)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=0;fontSize=11;" vertex="1" parent="bc-dp-classes-c3"><mxGeometry x="0" y="122" width="430" height="20" as="geometry"/></mxCell><mxCell id="bc-dp-classes-c9" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;" vertex="1" parent="bc-dp-classes-c3"><mxGeometry x="0" y="142" width="430" height="8" as="geometry"/></mxCell><mxCell id="bc-dp-classes-c10" value="+ from_records(records, game_xml, strict, check_legality, cache_dir) «classmethod»" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=0;fontSize=11;" vertex="1" parent="bc-dp-classes-c3"><mxGeometry x="0" y="150" width="430" height="36" as="geometry"/></mxCell><mxCell id="bc-dp-classes-c11" value="+ __len__() / __getitem__(i) → dict of arrays + metadata" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=0;fontSize=11;" vertex="1" parent="bc-dp-classes-c3"><mxGeometry x="0" y="186" width="430" height="20" as="geometry"/></mxCell><mxCell id="bc-dp-classes-c12" value="+ game_ids: List[str]" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=0;fontSize=11;" vertex="1" parent="bc-dp-classes-c3"><mxGeometry x="0" y="206" width="430" height="20" as="geometry"/></mxCell><mxCell id="bc-dp-classes-c13" value="+ subset(indices) → AttackFormationDataset" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=0;fontSize=11;" vertex="1" parent="bc-dp-classes-c3"><mxGeometry x="0" y="226" width="430" height="20" as="geometry"/></mxCell><mxCell id="bc-dp-classes-c14" value="+ split_by_game(val, test, seed) → {train, val, test}  (A10)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=0;fontSize=11;" vertex="1" parent="bc-dp-classes-c3"><mxGeometry x="0" y="246" width="430" height="20" as="geometry"/></mxCell><mxCell id="bc-dp-classes-c15" value="+ save(data_dir, splits)  → dataset.pkl, report.*, feature_names.json, splits.json" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=0;fontSize=11;" vertex="1" parent="bc-dp-classes-c3"><mxGeometry x="0" y="266" width="430" height="36" as="geometry"/></mxCell><mxCell id="bc-dp-classes-c16" value="+ load(data_dir) «classmethod»" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=0;fontSize=11;" vertex="1" parent="bc-dp-classes-c3"><mxGeometry x="0" y="302" width="430" height="20" as="geometry"/></mxCell><mxCell id="bc-dp-classes-c17" value="&lt;b&gt;_Builder&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;startSize=42;html=1;whiteSpace=wrap;childLayout=stackLayout;horizontal=1;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="560" height="370" as="geometry"/></mxCell><mxCell id="bc-dp-classes-c18" value="- paths, game_xml, check_legality" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=0;fontSize=11;" vertex="1" parent="bc-dp-classes-c17"><mxGeometry x="0" y="42" width="560" height="20" as="geometry"/></mxCell><mxCell id="bc-dp-classes-c19" value="- report: ValidationReport" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=0;fontSize=11;" vertex="1" parent="bc-dp-classes-c17"><mxGeometry x="0" y="62" width="560" height="20" as="geometry"/></mxCell><mxCell id="bc-dp-classes-c20" value="- rng: fm.SeededRng" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=0;fontSize=11;" vertex="1" parent="bc-dp-classes-c17"><mxGeometry x="0" y="82" width="560" height="20" as="geometry"/></mxCell><mxCell id="bc-dp-classes-c21" value="- d: GameDefinition, map: MapGraph" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=0;fontSize=11;" vertex="1" parent="bc-dp-classes-c17"><mxGeometry x="0" y="102" width="560" height="20" as="geometry"/></mxCell><mxCell id="bc-dp-classes-c22" value="- graph: StaticGraph, spec: FeatureSpec" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=0;fontSize=11;" vertex="1" parent="bc-dp-classes-c17"><mxGeometry x="0" y="122" width="560" height="20" as="geometry"/></mxCell><mxCell id="bc-dp-classes-c23" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition
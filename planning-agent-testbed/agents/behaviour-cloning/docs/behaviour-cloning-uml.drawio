="bc-dp-activity-e36" value="yes" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="bc-dp-activity-c15" target="bc-dp-activity-c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="bc-dp-activity-e37" value="no" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="bc-dp-activity-c15" target="bc-dp-activity-c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="bc-dp-activity-e38" value="" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="bc-dp-activity-c17" target="bc-dp-activity-c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="bc-dp-activity-e39" value="yes" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="bc-dp-activity-c18" target="bc-dp-activity-c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="bc-dp-activity-e40" value="no" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="bc-dp-activity-c18" target="bc-dp-activity-c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="bc-dp-activity-e41" value="" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="bc-dp-activity-c20" target="bc-dp-activity-c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="bc-dp-activity-e42" value="after all records" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="bc-dp-activity-c21" target="bc-dp-activity-c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="bc-dp-activity-e43" value="" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="bc-dp-activity-c22" target="bc-dp-activity-c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="bc-dp-activity-e44" value="" style="endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="bc-dp-activity-c23" target="bc-dp-activity-c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="bc-dp-activity-c45" value="&lt;b&gt;Why the replay?&lt;/b&gt;&lt;br&gt;Moving into an empty territory in combat move conquers it by blitzing, and later moves may route through it. LiveBridge treats every conquered territory as not blitzed (blocked), so conquered/blitzed are carried over from applying the recorded expert actions — the same lineage MCTS used. A8 checks that this replay reproduces every recorded snapshot." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=10;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="380" height="190" as="geometry"/></mxCell><mxCell id="bc-dp-activity-c46" value="&lt;b&gt;strict=True&lt;/b&gt; raises DatasetAssertionError on the first failure; otherwise every failure is listed in ValidationReport.failures and the sample in failed_samples." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=10;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="990" width="380" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="bc-train-classes" name="4 Training &amp; evaluation — class diagram"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bc-train-classes-c0" value="Training &amp; evaluation — class diagram (behaviour-cloning/bc_baseline, run_bc.py)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1600" height="30" as="geometry"/></mxCell><mxCell id="bc-train-classes-c1" value="Blue = agent classes · green = pipeline / model classes · purple = data containers · yellow = modules and free functions · orange = triplea_fm forward model / PyTorch · grey = TripleMind, engine, CLI, files." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1600" height="20" as="geometry"/></mxCell><mxCell id="bc-train-classes-c2" value="◆ composition (owns)   ◇ aggregation (holds a reference)   ▷ generalization   dashed → dependency (uses / creates)" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1600" height="20" as="geometry"/></mxCell><mxCell id="bc-train-classes-c3" value="«CLI»&lt;br&gt;&lt;b&gt;run_bc.py&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;startSize=42;html=1;whiteSpace=wrap;childLayout=stackLayout;horizontal=1;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="420" height="162" as="geometry"/></mxCell><mxCell id="bc-train-classes-c4" value="+ main()  subcommands: preprocess | train | evaluate | sanity" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=0;fontSize=11;" vertex="1" parent="bc-train-classes-c3"><mxGeometry x="0" y="42" width="420" height="20" as="geometry"/></mxCell><mxCell id="bc-train-classes-c5" value="+ get_inputs(args) → BCInputs  (mode choice, checks)" style="t
s" style="swimlane;fontStyle=1;align=center;html=1;whiteSpace=wrap;childLayout=stackLayout;horizontal=1;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;swimlaneFillColor=#ffffff;fillColor=#dae8fc;strokeColor=#6c8ebf;startSize=40;" vertex="1" parent="1"><mxGeometry x="1270" y="470" width="760" height="181" as="geometry"/></mxCell><mxCell id="b-classes-c56" value="END = CombatAction(end_phase=True);  ROLLOUT_STRENGTH_MARGIN = 1.5" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=wrap;fontSize=10;" vertex="1" parent="BbMod"><mxGeometry x="0" y="40" width="760" height="19" as="geometry"/></mxCell><mxCell id="b-classes-c57" value="BB_EFFICIENCY_HEADER = EFFICIENCY_HEADER + [reached_end_of_turn, num_actions_per_level, best_value_per_level, states_visited, transpositions, iterations_per_level]" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=wrap;fontSize=10;" vertex="1" parent="BbMod"><mxGeometry x="0" y="59" width="760" height="19" as="geometry"/></mxCell><mxCell id="b-classes-c58" value="BB_ROLLOUT_STATS_HEADER = ROLLOUT_STATS_HEADER + [tl, rollout_attacks]" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=wrap;fontSize=10;" vertex="1" parent="BbMod"><mxGeometry x="0" y="78" width="760" height="19" as="geometry"/></mxCell><mxCell id="b-classes-c59" value="BB_ACTION_SEQ_HEADER, SIBLING_VALUES_HEADER  (as the other OEP agents)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstra
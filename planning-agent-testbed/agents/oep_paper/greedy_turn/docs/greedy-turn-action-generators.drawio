><mxCell id="q-dfs-c49" value="&lt;b&gt;Greedy Action (greedy_action/greedy.py)&lt;/b&gt; uses the same Phase calls one level at a time: actions(state); each candidate rated by step + finish(end_of) (+ battles) + evaluate_state, within the level's time share (remaining / levels_left); commit the best with step(); stop at END; out of time: complete_greedily." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1340" y="120" width="340" height="160" as="geometry"/></mxCell><mxCell id="q-dfs-c50" value="vanilla_mcts, ne_mcts, bb_mcts and oep build their trees, genomes or rollouts from the same Phase interface." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1340" y="300" width="340" height="70" as="geometry"/></mxCell><mxCell id="q-dfs-c51" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="1340" y="400" width="200" height="20" as="geometry"/></mxCell><mxCell id="q-dfs-c52" value="step" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1340" y="424" width="120" height="26" as="geometry"/></mxCell><mxCell id="q-dfs-c53" value="actions returned (DFS children)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1470" y="424" width="210" height="26" as="geometry"/></mxCell><mxCell id="q-dfs-c54" value="forced moves (not an action)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;s
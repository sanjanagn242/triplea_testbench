.)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=wrap;fontSize=10;" vertex="1" parent="q-classes-c102"><mxGeometry x="0" y="106" width="330" height="18" as="geometry"/></mxCell><mxCell id="q-classes-c109" value="+ fight_battles(sim, rng)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=wrap;fontSize=10;" vertex="1" parent="q-classes-c102"><mxGeometry x="0" y="124" width="330" height="18" as="geometry"/></mxCell><mxCell id="q-classes-c110" value="Candidate" style="swimlane;fontStyle=1;align=center;startSize=26;html=1;whiteSpace=wrap;childLayout=stackLayout;horizontal=1;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="35" y="740" width="330" height="44" as="geometry"/></mxCell><mxCell id="q-classes-c111" value="- action, values" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=wrap;fontSize=10;" vertex="1" parent="q-classes-c110"><mxGeometry x="0" y="26" width="330" height="18" as="geometry"/></mxCell><mxCell id="q-classes-c112" value="vanilla_mcts, ne_mcts, bb_mcts and oep import the Phase classes (PurchasePhase, CombatPhase, NoncombatPhase) and complete_greedily directly; only their selection differs." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="830" width="360" height="60" as="geometry"/></mxCell><mxCell id="q-classes-c113" value="" style="endArrow=block;endSize=12;endFill=0;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="q-classes-c25" target="q-classes-c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-classes-c114" value="" style="endArrow=block;endSize=12;endFill=0;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="q-classes-c30" target="q-classes-c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-classes-c115" value="" style="endArrow=block;endSize=12;endFill=0;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="q-classes-c34" target="q-classes-c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-classes-c116" value="«create»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;dashed=1;" edge="1" parent="1" source="q-classes-c25" target="q-classes-c38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-classes-c117" value="«call»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;dashed=1;exitX=1;exitY=0.3;" edge="1" parent="1" source="q-classes-c30" target="q-classes-c53"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-classes-c118" value="«create»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;dashed=1;" edge="1" parent="1" source="q-classes-c30" target="q-classes-c48"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-classes-c119" value="«call»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;dashed=1;" edge="1" parent="1" source="q-classes-c34" target="q-classes-c72"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-classes-c120" value="«create»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;dashed=1;" edge="1" parent="1" source="q-classes-c72" target="q-classes-c66"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-classes-c121" value="«use»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;dashed=1;" edge="1" parent="1" source="q-classes-c72" target="q-classes-c78"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-classes-c122" value="«use» via ag" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;dashed=1;" edge="1" parent="1" source="q-classes-c78" target="q-classes-c59"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-classes-c123" value="ag" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;dashed=1;exitX=1;exitY=0.5;" edge="1" parent="1" source="q-classes-c83" target="q-classes-c53"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-classes-c124" value="make_phases /&lt;br&gt;complete_greedily" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;dashed=1;exitX=1;exitY=0.2;" edge="1" parent="1" source="q-classes-c87" target="q-classes-c42"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-classes-c125" value="make_phases /&lt;br&gt;complete_greedily" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;dashed=1;exitX=1;exitY=0.3;" edge="1" parent="1" source="q-classes-c102" target="q-classes-c42"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-classes-c126" value="1 *" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;dashed=1;" edge="1" parent="1" source="q-classes-c87" target="q-classes-c98"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-classes-c127" value="1 *" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;dashed=1;" edge="1" parent="1" source="q-classes-c102" target="q-classes-c110"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-classes-c128" value="state" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;dashed=1;exitX=1;exitY=0.5;" edge="1" parent="1" source="q-classes-c98" target="q-classes-c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-classes-c129" value="&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; style=&quot;border-collapse:collapse;font-size:10px;&quot;&gt;&lt;tr style=&quot;background:#eeeeee;&quot;&gt;&lt;th&gt;phase&lt;/th&gt;&lt;th&gt;start (forced)&lt;/th&gt;&lt;th&gt;actions(state), highest-rated first&lt;/th&gt;&lt;th&gt;step(state, action)&lt;/th&gt;&lt;th&gt;key(state)&lt;/th&gt;&lt;th&gt;action_key&lt;/th&gt;&lt;th&gt;END&lt;/th&gt;&lt;th&gt;levels_left&lt;/th&gt;&lt;th&gt;response_actions&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;purchase&lt;/td&gt;&lt;td&gt;none; info = ()&lt;/td&gt;&lt;td&gt;affordable candidate units, best (attack + defense) / PU first, then END; only END without a factory&lt;/td&gt;&lt;td&gt;buy 1 unit; info = units bought&lt;/td&gt;&lt;td&gt;units bought (a multiset)&lt;/td&gt;&lt;td&gt;rule_id&lt;/td&gt;&lt;td&gt;always offered, last&lt;/td&gt;&lt;td&gt;most units of one offered rule the balance pays for&lt;/td&gt;&lt;td&gt;one PurchaseAction with the counts&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;combat move&lt;/td&gt;&lt;td&gt;none; info = {}&lt;/td&gt;&lt;td&gt;one all-in attack per target not attacked: strength &amp;gt; 1.5 × defence (priority order), END, the other attacks&lt;/td&gt;&lt;td&gt;apply its moves; info ∪= {target}&lt;/td&gt;&lt;td&gt;(unit id, territory) of my moved units&lt;/td&gt;&lt;td&gt;to_terr&lt;/td&gt;&lt;td&gt;always offered, after the strong attacks&lt;/td&gt;&lt;td&gt;attacks offered&lt;/td&gt;&lt;td&gt;every attack's moves&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;non-combat move&lt;/td&gt;&lt;td&gt;land_air_moves; info = ({}, units moved)&lt;/td&gt;&lt;td&gt;reinforcement sets for the neediest territory, strongest first, then its skip; END with the positioning moves once none is left&lt;/td&gt;&lt;td&gt;apply its moves; info = (action.excluded, moved ∪ units)&lt;/td&gt;&lt;td&gt;(decided territories, (unit id, territory) of units moved)&lt;/td&gt;&lt;td&gt;(to_terr, unit ids)&lt;/td&gt;&lt;td&gt;only when nothing is left; end_of(state) builds one anywhere&lt;/td&gt;&lt;td&gt;territories still short of cover&lt;/td&gt;&lt;td&gt;forced moves, every action's moves, END's positioning moves&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=fill;" vertex="1" parent="1"><mxGeometry x="20" y="1010" width="1720" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="q-purchase" name="2 Purchase"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1040" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="q-purchase-c1" value="Purchase: PurchasePhase.actions / step / key" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1620" height="30" as="geometry"/></mxCell><mxCell id="q-purchase-c2" value="Every affordable unit is offered at every node, best (attack + defense) per PU first, with END last. Different orders of the same units share a key, so the search keeps one of them." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1620" height="36" as="geometry"/></mxCell><mxCell id="q-purchase-c3" value="search  (GreedyTurnSearch / GreedyActionSearch)" style="swimlane;html=1;startSize=28;fillColor=#f8f8f8;strokeColor=#999999;fontStyle=1;fontSize=12;swimlaneFillColor=none;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="480" height="920" as="geometry"/></mxCell><mxCell id="q-purchase-c4" value="PurchasePhase  (phases.py)" style="swimlane;html=1;startSize=28;fillColor=#f8f8f8;strokeColor=#999999;fontStyle=1;fontSize=12;swimlaneFillColor=none;dashed=1;" vertex="1" parent="1"><mxGeometry x="520" y="90" width="640" height="920" as="geometry"/></mxCell><mxCell id="q-purchase-c5" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="245" y="130" width="30" height="30" as="geometry"/></mxCell><mxCell id="q-purchase-c6" value="&lt;b&gt;phase.start(sim)&lt;/b&gt;&lt;br&gt;PhaseState(sim, depth 0, info = ())  no forced moves" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="580" y="175" width="520" height="55" as="geometry"/></mxCell><mxCell id="q-purchase-c7" value="&lt;b&gt;phase.actions(state)&lt;/b&gt; at a plan" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="265" width="400" height="45" as="geometry"/></mxCell><mxCell id="q-purchase-c8" value="I own a factory on&lt;br&gt;a territory I own?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="255" width="200" height="90" as="geometry"/></mxCell><mxCell id="q-purchase-c9" value="&lt;b&gt;return&lt;/b&gt; [END]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="990" y="270" width="150" height="55" as="geometry"/></mxCell><mxCell id="q-purchase-c10" value="&lt;b&gt;units()&lt;/b&gt;  (computed once)&lt;br&gt;production frontier rules with one result, quantity 1, paid in PUs only, cost &amp;gt; 0, land, not infrastructure, not AA → PurchaseUnit(rule_id, unit_type, costs, strength = (attack + defense) / cost)&lt;br&gt;sorted by (−strength, rule_id)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="580" y="375" width="520" height="100" as="geometry"/></mxCell><mxCell id="q-purchase-c11" value="keep those whose every cost ≤ my balance (order kept)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="580" y="505" width="520" height="45" as="geometry"/></mxCell><mxCell id="q-purchase-c12" value="&lt;b&gt;return&lt;/b&gt; affordable units + [END]  (END last)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="580" y="580" width="520" height="50" as="geometry"/></mxCell><mxCell id="q-purchase-c13" value="&lt;b&gt;actions&lt;/b&gt; = children to try, in this order" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="580" width="400" height="50" as="geometry"/></mxCell><mxCell id="q-purchase-c14" value="&lt;b&gt;phase.step(state, unit)&lt;/b&gt;&lt;br&gt;apply fm.PurchaseAction(((rule_id, 1),)); info = sorted (rule id, count) pairs; depth + 1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="580" y="670" width="520" height="70" as="geometry"/></mxCell><mxCell id="q-purchase-c15" value="&lt;b&gt;phase.key(state)&lt;/b&gt; = info  (the multiset of units bought)&lt;br&gt;already seen → transposition, child skipped (Greedy Turn)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="670" width="400" height="70" as="geometry"/></mxCell><mxCell id="q-purchase-c16" value="&lt;b&gt;END&lt;/b&gt;: phase.finish → EndPhaseAction&lt;br&gt;response_actions(sequence) → one PurchaseAction with the count of each rule" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="790" width="400" height="70" as="geometry"/></mxCell><mxCell id="q-purchase-c17" value="" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="245" y="900" width="30" height="30" as="geometry"/></mxCell><mxCell id="q-purchase-c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;exitX=1;exitY=0.5;" edge="1" parent="1" source="q-purchase-c5" target="q-purchase-c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-purchase-c19" value="root plan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="q-purchase-c6" target="q-purchase-c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-purchase-c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="q-purchase-c7" target="q-purchase-c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-purchase-c21" value="[no]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="q-purchase-c8" target="q-purchase-c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-purchase-c22" value="[yes]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="q-purchase-c8" target="q-purchase-c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-purchase-c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="q-purchase-c10" target="q-purchase-c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-purchase-c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="q-purchase-c11" target="q-purchase-c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-purchase-c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="q-purchase-c12" target="q-purchase-c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-purchase-c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;exitX=0.5;exitY=1;entryX=1;entryY=0.25;" edge="1" parent="1" source="q-purchase-c9" target="q-purchase-c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-purchase-c27" value="each non-END unit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;exitX=0.75;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="q-purchase-c13" target="q-purchase-c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-purchase-c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;exitX=0.5;exitY=1;entryX=1;entryY=0.75;" edge="1" parent="1" source="q-purchase-c14" target="q-purchase-c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-purchase-c29" value="new child: its actions next" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="q-purchase-c15" target="q-purchase-c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-purchase-c30" value="END chosen" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;exitX=0.25;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="q-purchase-c13" target="q-purchase-c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-purchase-c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="q-purchase-c16" target="q-purchase-c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-purchase-c32" value="&lt;b&gt;Compared with heterogeneous-mcts&lt;/b&gt;&lt;br&gt;hmcts offers units only from the index of the last one bought (frontier order) and never offers END while something is affordable, so it needs no transposition table. Here END is offered at every plan, so stopping early is a candidate, and orders of the same units are merged by key()." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1190" y="120" width="490" height="130" as="geometry"/></mxCell><mxCell id="q-purchase-c33" value="&lt;b&gt;Rating&lt;/b&gt;&lt;br&gt;evaluate_state counts neither units in hand nor positions, so purchase leaves almost always tie. The order of actions() then decides: the highest (attack + defense) per PU first, and the first of equal values wins. complete_greedily buys the first affordable unit until only END is left." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1190" y="270" width="490" height="120" as="geometry"/></mxCell><mxCell id="q-purchase-c34" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="1190" y="420" width="200" height="20" as="geometry"/></mxCell><mxCell id="q-purchase-c35" value="step" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1190" y="444" width="120" height="26" as="geometry"/></mxCell><mxCell id="q-purchase-c36" value="actions returned (DFS children)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1320" y="444" width="210" height="26" as="geometry"/></mxCell><mxCell id="q-purchase-c37" value="forced moves (not an action)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1190" y="478" width="200" height="26" as="geometry"/></mxCell><mxCell id="q-purchase-c38" value="guard" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1400" y="474" width="90" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="q-combat" name="3 Combat move"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="q-combat-c1" value="Combat move: CombatPhase.actions / step / key" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1620" height="30" as="geometry"/></mxCell><mxCell id="q-combat-c2" value="One all-in attack per enemy territory not attacked yet: every unmoved unit of mine that can reach it. Attacks that beat the defence by 1.5× come first in priority order, then END, then the others." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1620" height="36" as="geometry"/></mxCell><mxCell id="q-combat-c3" value="search" style="swimlane;html=1;startSize=28;fillColor=#f8f8f8;strokeColor=#999999;fontStyle=1;fontSize=12;swimlaneFillColor=none;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="460" height="960" as="geometry"/></mxCell><mxCell id="q-combat-c4" value="CombatPhase  (phases.py, generators via ag)" style="swimlane;html=1;startSize=28;fillColor=#f8f8f8;strokeColor=#999999;fontStyle=1;fontSize=12;swimlaneFillColor=none;dashed=1;" vertex="1" parent="1"><mxGeometry x="500" y="90" width="700" height="960" as="geometry"/></mxCell><mxCell id="q-combat-c5" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="235" y="130" width="30" height="30" as="geometry"/></mxCell><mxCell id="q-combat-c6" value="&lt;b&gt;phase.start(sim)&lt;/b&gt;: PhaseState(sim, 0, info = frozenset())" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="560" y="170" width="580" height="45" as="geometry"/></mxCell><mxCell id="q-combat-c7" value="&lt;b&gt;phase.actions(state)&lt;/b&gt; at a plan" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="50" y="250" width="400" height="45" as="geometry"/></mxCell><mxCell id="q-combat-c8" value="game = search.view(sim); strong = [], weak = []&lt;br&gt;for target in &lt;b&gt;ag.enemy_territories_by_priority&lt;/b&gt;(game, me)  (enemy land next to mine, TripleMind priority)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="560" y="245" width="580" height="65" as="geometry"/></mxCell><mxCell id="q-combat-c9" value="next target?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="750" y="335" width="200" height="70" as="geometry"/></mxCell><mxCell id="q-combat-c10" value="target in info&lt;br&gt;(attacked)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="750" y="430" width="200" height="80" as="geometry"/></mxCell><mxCell id="q-combat-c11" value="&lt;b&gt;ag.get_reachable_units&lt;/b&gt;(game, target, me): my unmoved, mobile, non-sea units that can reach it (blitz rules; air only if it can land after)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="560" y="535" width="580" height="55" as="geometry"/></mxCell><mxCell id="q-combat-c12" value="any?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="800" y="610" width="100" height="60" as="geometry"/></mxCell><mxCell id="q-combat-c13" value="CombatAction(target, moves = &lt;b&gt;ag._group_moves&lt;/b&gt;(all reachable), strength = &lt;b&gt;ag.calculate_attack_strength&lt;/b&gt;(all reachable))&lt;br&gt;defence = &lt;b&gt;ag.defender_strength&lt;/b&gt;(target)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="560" y="690" width="580" height="65" as="geometry"/></mxCell><mxCell id="q-combat-c14" value="strength &amp;gt; 1.5 ×&lt;br&gt;defence?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="750" y="775" width="200" height="80" as="geometry"/></mxCell><mxCell id="q-combat-c15" value="strong.append" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="600" y="795" width="110" height="40" as="geometry"/></mxCell><mxCell id="q-combat-c16" value="weak.append" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="990" y="795" width="110" height="40" as="geometry"/></mxCell><mxCell id="q-combat-c17" value="&lt;b&gt;return&lt;/b&gt; strong + [END] + weak" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1000" y="345" width="180" height="50" as="geometry"/></mxCell><mxCell id="q-combat-c18" value="&lt;b&gt;actions&lt;/b&gt; = children to try, in this order" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="50" y="345" width="400" height="50" as="geometry"/></mxCell><mxCell id="q-combat-c19" value="&lt;b&gt;phase.step(state, attack)&lt;/b&gt;&lt;br&gt;apply its MoveActions (no dice); info ∪= {target}" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="50" y="440" width="400" height="60" as="geometry"/></mxCell><mxCell id="q-combat-c20" value="&lt;b&gt;phase.key(state)&lt;/b&gt; = sorted (unit id, territory) of my moved units&lt;br&gt;already seen → transposition, skipped (Greedy Turn)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="50" y="530" width="400" height="65" as="geometry"/></mxCell><mxCell id="q-combat-c21" value="&lt;b&gt;END&lt;/b&gt;: phase.finish → EndPhaseAction; then the search plays the battle phase (fight_battles: dice or fast_battle, default casualties, no retreat) and rates the state with evaluate_state" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="50" y="640" width="400" height="85" as="geometry"/></mxCell><mxCell id="q-combat-c22" value="" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="235" y="760" width="30" height="30" as="geometry"/></mxCell><mxCell id="q-combat-c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;exitX=1;exitY=0.5;" edge="1" parent="1" source="q-combat-c5" target="q-combat-c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-combat-c24" value="root plan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="q-combat-c6" target="q-combat-c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-combat-c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="q-combat-c7" target="q-combat-c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-combat-c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="q-combat-c8" target="q-combat-c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-combat-c27" value="[none left]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="q-combat-c9" target="q-combat-c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-combat-c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;exitX=0.5;exitY=0;entryX=1;entryY=0.25;" edge="1" parent="1" source="q-combat-c17" target="q-combat-c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-combat-c29" value="[target]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="q-combat-c9" target="q-combat-c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-combat-c30" value="[yes]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="q-combat-c10" target="q-combat-c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-combat-c31" value="[no]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="q-combat-c10" target="q-combat-c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-combat-c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="q-combat-c11" target="q-combat-c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-combat-c33" value="[no]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="q-combat-c12" target="q-combat-c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-combat-c34" value="[yes]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="q-combat-c12" target="q-combat-c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-combat-c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="q-combat-c13" target="q-combat-c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-combat-c36" value="[yes]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="q-combat-c14" target="q-combat-c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-combat-c37" value="[no]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="q-combat-c14" target="q-combat-c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-combat-c38" value="loop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;exitX=0;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="q-combat-c15" target="q-combat-c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-combat-c39" value="loop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;exitX=1;exitY=0.5;entryX=1;entryY=0.75;" edge="1" parent="1" source="q-combat-c16" target="q-combat-c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-combat-c40" value="each non-END attack" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="q-combat-c18" target="q-combat-c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-combat-c41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="q-combat-c19" target="q-combat-c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-combat-c42" value="new child: its actions next" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="q-combat-c20" target="q-combat-c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-combat-c43" value="END chosen" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="q-combat-c20" target="q-combat-c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-combat-c44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="q-combat-c21" target="q-combat-c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-combat-c45" value="&lt;b&gt;Compared with heterogeneous-mcts&lt;/b&gt;&lt;br&gt;hmcts calls ag.combat_actions: several attack sets of growing strength for the single most important target, plus a skip, one target per node. Here phases.py calls the same helpers but offers one all-in attack for every target at once; END plays the part of skipping the rest. Units moved by an earlier attack in the plan are no longer reachable, so later attacks in a plan get smaller." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1220" y="120" width="460" height="165" as="geometry"/></mxCell><mxCell id="q-combat-c46" value="&lt;b&gt;Rating&lt;/b&gt;&lt;br&gt;Only the combat move is rated after battles. With dice, Greedy Turn resamples every leaf after a finished DFS (the same seed per sweep); Greedy Action samples each level's candidates round-robin within its time share (remaining time / levels_left)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1220" y="305" width="460" height="110" as="geometry"/></mxCell><mxCell id="q-combat-c47" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="1220" y="445" width="200" height="20" as="geometry"/></mxCell><mxCell id="q-combat-c48" value="step" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1220" y="469" width="120" height="26" as="geometry"/></mxCell><mxCell id="q-combat-c49" value="actions returned (DFS children)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1350" y="469" width="210" height="26" as="geometry"/></mxCell><mxCell id="q-combat-c50" value="forced moves (not an action)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1220" y="503" width="200" height="26" as="geometry"/></mxCell><mxCell id="q-combat-c51" value="guard" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1430" y="499" width="90" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="q-noncombat" name="4 Non-combat move"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="q-noncombat-c1" value="Non-combat move: NoncombatPhase.start / actions / step / key / end_of" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1670" height="30" as="geometry"/></mxCell><mxCell id="q-noncombat-c2" value="Forced air landings at start; then one territory short of cover per action (its reinforcement sets strongest first, then its skip), from noncombat_generators; END carries the positioning moves." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1670" height="36" as="geometry"/></mxCell><mxCell id="q-noncombat-c3" value="search" style="swimlane;html=1;startSize=28;fillColor=#f8f8f8;strokeColor=#999999;fontStyle=1;fontSize=12;swimlaneFillColor=none;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="460" height="980" as="geometry"/></mxCell><mxCell id="q-noncombat-c4" value="NoncombatPhase  (phases.py)  →  noncombat_generators" style="swimlane;html=1;startSize=28;fillColor=#f8f8f8;strokeColor=#999999;fontStyle=1;fontSize=12;swimlaneFillColor=none;dashed=1;" vertex="1" parent="1"><mxGeometry x="500" y="90" width="760" height="980" as="geometry"/></mxCell><mxCell id="q-noncombat-c5" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="235" y="130" width="30" height="30" as="geometry"/></mxCell><mxCell id="q-noncombat-c6" value="&lt;b&gt;phase.start(sim)&lt;/b&gt;: &lt;b&gt;ncg.land_air_moves&lt;/b&gt;(view, d, me): air that cannot end the phase where it stands flies to the landing spot most short of cover. Applied now; info = (frozenset(), units moved). Returned as the forced moves, sent first." style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="560" y="165" width="660" height="70" as="geometry"/></mxCell><mxCell id="q-noncombat-c7" value="&lt;b&gt;phase.actions(state)&lt;/b&gt; at a plan" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="50" y="265" width="400" height="45" as="geometry"/></mxCell><mxCell id="q-noncombat-c8" value="&lt;b&gt;ncg.noncombat_actions&lt;/b&gt;(view, d, excluded, moved, me)&lt;br&gt;&lt;b&gt;_Plan&lt;/b&gt;: strength = Σ defense_value; want = THREAT_COVER × enemy threat (home factory: HOME_COVER, HOME_KEEP; frontier: FRONTIER_MIN); movable = units not in moved" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="560" y="260" width="660" height="75" as="geometry"/></mxCell><mxCell id="q-noncombat-c9" value="targets = my territories not excluded with shortfall &amp;gt; 0, by priority × shortfall" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="560" y="360" width="660" height="45" as="geometry"/></mxCell><mxCell id="q-noncombat-c10" value="next target?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="790" y="430" width="200" height="70" as="geometry"/></mxCell><mxCell id="q-noncombat-c11" value="&lt;b&gt;return&lt;/b&gt; [NoncombatAction(end_phase, excluded, moves = positioning_moves)]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1030" y="435" width="210" height="70" as="geometry"/></mxCell><mxCell id="q-noncombat-c12" value="donors that can end on the target, by defense_gain − donor_loss; build sets whenever the value sent reaches 0.5, 1.0, 1.5 × shortfall (sources keep their own cover), plus everything that can be spared; excluded.add(target)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="560" y="525" width="660" height="70" as="geometry"/></mxCell><mxCell id="q-noncombat-c13" value="any set?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="790" y="615" width="200" height="65" as="geometry"/></mxCell><mxCell id="q-noncombat-c14" value="&lt;b&gt;return&lt;/b&gt; sets strongest first + skip(target), each NoncombatAction carrying excluded (the territories decided once it is played)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="560" y="700" width="660" height="55" as="geometry"/></mxCell><mxCell id="q-noncombat-c15" value="&lt;b&gt;actions&lt;/b&gt; = children to try, in this order" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="50" y="440" width="400" height="50" as="geometry"/></mxCell><mxCell id="q-noncombat-c16" value="&lt;b&gt;phase.step(state, action)&lt;/b&gt;&lt;br&gt;apply its MoveActions; info = (action.excluded, moved ∪ its units)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="50" y="790" width="400" height="60" as="geometry"/></mxCell><mxCell id="q-noncombat-c17" value="&lt;b&gt;phase.key(state)&lt;/b&gt; = (decided territories, (unit id, territory) of units moved)&lt;br&gt;already seen → transposition, skipped (Greedy Turn)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="50" y="875" width="400" height="65" as="geometry"/></mxCell><mxCell id="q-noncombat-c18" value="&lt;b&gt;END&lt;/b&gt;: phase.finish plays END's positioning moves (a rejected one is skipped), then EndPhaseAction" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="50" y="530" width="400" height="60" as="geometry"/></mxCell><mxCell id="q-noncombat-c19" value="" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="235" y="620" width="30" height="30" as="geometry"/></mxCell><mxCell id="q-noncombat-c20" value="&lt;b&gt;phase.end_of(state)&lt;/b&gt;: END with &lt;b&gt;ncg.positioning_moves&lt;/b&gt; from this state, also while territories are undecided (Greedy Action's rating of a candidate, complete_greedily)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="560" y="790" width="660" height="60" as="geometry"/></mxCell><mxCell id="q-noncombat-c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;exitX=1;exitY=0.5;" edge="1" parent="1" source="q-noncombat-c5" target="q-noncombat-c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-noncombat-c22" value="root plan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;exitX=0.25;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="q-noncombat-c6" target="q-noncombat-c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-noncombat-c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="q-noncombat-c7" target="q-noncombat-c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-noncombat-c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="q-noncombat-c8" target="q-noncombat-c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-noncombat-c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="q-noncombat-c9" target="q-noncombat-c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-noncombat-c26" value="[none left]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="q-noncombat-c10" target="q-noncombat-c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-noncombat-c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;exitX=0.5;exitY=0;entryX=1;entryY=0.25;" edge="1" parent="1" source="q-noncombat-c11" target="q-noncombat-c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-noncombat-c28" value="[target]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="q-noncombat-c10" target="q-noncombat-c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-noncombat-c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="q-noncombat-c12" target="q-noncombat-c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-noncombat-c30" value="[no] pass over" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;exitX=1;exitY=0.5;entryX=1;entryY=0.75;" edge="1" parent="1" source="q-noncombat-c13" target="q-noncombat-c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-noncombat-c31" value="[yes]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="q-noncombat-c13" target="q-noncombat-c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-noncombat-c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;exitX=0;exitY=0.5;entryX=1;entryY=0.75;" edge="1" parent="1" source="q-noncombat-c14" target="q-noncombat-c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-noncombat-c33" value="each non-END action" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;exitX=0.75;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="q-noncombat-c15" target="q-noncombat-c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-noncombat-c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="q-noncombat-c16" target="q-noncombat-c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-noncombat-c35" value="new child: its actions next" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="q-noncombat-c17" target="q-noncombat-c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-noncombat-c36" value="END offered" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;exitX=0.25;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="q-noncombat-c15" target="q-noncombat-c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-noncombat-c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" parent="1" source="q-noncombat-c18" target="q-noncombat-c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q-noncombat-c38" value="&lt;b&gt;positioning_moves&lt;/b&gt;&lt;br&gt;Sources farthest from the frontier first; each unit its source can spare moves to the reachable territory of mine with the best defense_gain + advance toward the frontier + 0.2 × max(0, 5 − distance to an objective) − donor_loss, if positive." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1280" y="120" width="450" height="110" as="geometry"/></mxCell><mxCell id="q-noncombat-c39" value="&lt;b&gt;Compared with heterogeneous-mcts&lt;/b&gt;&lt;br&gt;The same three steps and the same generator. This copy of noncombat_generators adds `excluded` to every NoncombatAction, so step() moves to a child without generating the parent's options again; and END is offered only once nothing is left, as in hmcts, but end_of() can build one anywhere." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1280" y="250" width="450" height="130" as="geometry"/></mxCell><mxCell id="q-noncombat-c40" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="1280" y="410" width="200" height="20" as="geometry"/></mxCell><mxCell id="q-noncombat-c41" value="step" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1280" y="434" width="120" height="26" as="geometry"/></mxCell><mxCell id="q-noncombat-c42" value="actions returned (DFS children)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1410" y="434" width="210" height="26" as="geometry"/></mxCell><mxCell id="q-noncombat-c43" value="forced moves (not an action)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1280" y="468" width="200" height="26" as="geometry"/></mxCell><mxCell id="q-noncombat-c44" value="guard" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1490" y="464" width="90" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="q-dfs" name="5 Greedy Turn sequence search"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1260" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="q-dfs-c1" value="Greedy Turn: how the action sequences are generated and chosen (GreedyTurnSearch.search)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1620" height="30" as="geometry"/></mxCell><mxCell id="q-dfs-c2" value="A depth-first search over plans in the order actions() returns them. A plan where END is offered is also a leaf (ending the phase there); the transposition table skips plans reached by another order." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1620" height="36" as="geometry"/></mxCell><mxCell id="q-dfs-c3" value="GreedyTurnSearch  (greedy_turn.py)" style="swimlane;html=1;startSize=28;fillColor=#f8f8f8;strokeColor=#999999;fontStyle=1;fontSize=12;swimlaneFillColor=none;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="760" height="1150" as="geometry"/></mxCell><mxCell id="q-dfs-c4" value="Phase  (phases.py)" style="swimlane;html=1;startSize=28;fillColor=#f8f8f8;strokeColor=#999999;fontStyle=1;fontSize=12;swimlaneFillColor=none;dashed=1;" vertex="1" parent="1"><mxGeometry x="800" y="90" width="520" height="1150" as="geometry"/></mxCell><mxCell id="q-dfs-c5" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="385" y="130" width="30" height="30" as="geometry"/></mxCell><mxCell id="q-dfs-c6" value="phase = phases[phase_name]; deadline = now + TRIPLEA_GREEDY_SECONDS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="200" y="175" width="400" height="45" as="geometry"/></mxCell><mxCell id="q-dfs-c7" value="&lt;b&gt;start(root_sim.clone())&lt;/b&gt; → (root state, forced moves)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="860" y="175" width="420" height="45" as="geometry"/></mxCell><mxCell id="q-dfs-c8" value="root = Node(root state); seen = {key(root)}; stack = [root]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="200" y="245" width="400" height="45" as="geometry"/></mxCell><mxCell id="q-dfs-c9" value="stack and&lt;br&gt;time left?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="315" width="200" height="80" as="geometry"/></mxCell><mxCell id="q-dfs-c10" value="node = stack.pop()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="200" y="420" width="400" height="40" as="geometry"/></mxCell><mxCell id="q-dfs-c11" value="&lt;b&gt;actions(node.state)&lt;/b&gt;, highest-rated first" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="860" y="415" width="420" height="45" as="geometry"/></mxCell><mxCell id="q-dfs-c12" value="END offered?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="485" width="200" height="70" as="geometry"/></mxCell><mxCell id="q-dfs-c13" value="&lt;b&gt;evaluate&lt;/b&gt;: clone; &lt;b&gt;finish(state, END)&lt;/b&gt;; combat move: fight_battles; evaluate_state → node.values, leaves.append(node)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="580" width="400" height="65" as="geometry"/></mxCell><mxCell id="q-dfs-c14" value="for each non-END action: child state = clone" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="200" y="670" width="400" height="40" as="geometry"/></mxCell><mxCell id="q-dfs-c15" value="&lt;b&gt;step(child, action, move_rng)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="860" y="670" width="420" height="40" as="geometry"/></mxCell><mxCell id="q-dfs-c16" value="rejected, or&lt;br&gt;&lt;b&gt;key(child)&lt;/b&gt; in seen?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="735" width="200" height="80" as="geometry"/></mxCell><mxCell id="q-dfs-c17" value="transpositions + 1  (skip)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="560" y="755" width="200" height="40" as="geometry"/></mxCell><mxCell id="q-dfs-c18" value="seen.add(key); node.children.append(Node(child))" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="200" y="840" width="400" height="40" as="geometry"/></mxCell><mxCell id="q-dfs-c19" value="stack.extend(reversed(children))  (the first action is searched first)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="200" y="905" width="400" height="40" as="geometry"/></mxCell><mxCell id="q-dfs-c20" value="combat move with dice and DFS finished: resample every leaf until the deadline (same seed per sweep)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="230" height="90" as="geometry"/></mxCell><mxCell id="q-dfs-c21" value="&lt;b&gt;backup&lt;/b&gt;: node value = best mean leaf value below it" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="230" height="60" as="geometry"/></mxCell><mxCell id="q-dfs-c22" value="from the root: best sibling (END or a child, first of equal values) until END" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="980" width="400" height="50" as="geometry"/></mxCell><mxCell id="q-dfs-c23" value="stopped short of END: &lt;b&gt;complete_greedily(phase, state)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="860" y="980" width="420" height="50" as="geometry"/></mxCell><mxCell id="q-dfs-c24" value="&lt;b&gt;return&lt;/b&gt; forced + &lt;b&gt;response_actions(sequence)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="860" y="1070" 
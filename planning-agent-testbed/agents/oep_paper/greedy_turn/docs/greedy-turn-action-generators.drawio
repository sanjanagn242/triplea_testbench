<mxfile host="app.diagrams.net" type="device"><diagram id="q-classes" name="1 Modules &amp; classes"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1260" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="q-classes-c1" value="Greedy Turn: move-sequence generation, modules and classes" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1680" height="30" as="geometry"/></mxCell><mxCell id="q-classes-c2" value="The actions are generated by phases.py and the generator modules it calls. These files are byte-identical copies in every all-phase OEP agent (greedy_action, greedy_turn, vanilla_mcts, ne_mcts, bb_mcts, oep); ../check-shared-files.sh fails when they drift. Greedy Turn (greedy_turn.py) and Greedy Action (greedy_action/greedy.py) differ only in how they select among the actions." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1680" height="36" as="geometry"/></mxCell><mxCell id="q-classes-c3" value="Shared modules: identical in greedy_action, greedy_turn, vanilla_mcts, ne_mcts, bb_mcts, oep" style="rounded=1;arcSize=1;fillColor=#fafafa;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="400" y="90" width="1340" height="900" as="geometry"/></mxCell><mxCell id="q-classes-c4" value="«module» phases.py" style="rounded=1;arcSize=2;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="420" y="125" width="640" height="850" as="geometry"/></mxCell><mxCell id="q-classes-c5" value="PhaseState" style="swimlan